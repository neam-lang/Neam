// Query processing and transformation

module std.rag.query;

use std.rag.error;

pub fun query_text(text) {
  return { kind: "Text", text: text };
}

pub fun query_with_context(text, context) {
  return { kind: "Contextual", text: text, context: context };
}

pub fun query_transformer_builder(llm) {
  return {
    llm: llm,
    enable_expansion: false,
    enable_decomposition: false,
    enable_rewrite: false,
    max_variants: 3
  };
}

pub fun with_query_expansion(builder, enabled) {
  builder.enable_expansion = enabled;
  return builder;
}

pub fun with_query_decomposition(builder, enabled) {
  builder.enable_decomposition = enabled;
  return builder;
}

pub fun with_query_rewrite(builder, enabled) {
  builder.enable_rewrite = enabled;
  return builder;
}

pub fun with_max_variants(builder, count) {
  builder.max_variants = count;
  return builder;
}

pub fun build_query_transformer(builder) {
  if (builder.llm == nil) {
    return { ok: false, error: error.config_error("llm", "LLM is required") };
  }

  return {
    ok: true,
    value: {
      kind: "QueryTransformer",
      llm: builder.llm,
      enable_expansion: builder.enable_expansion,
      enable_decomposition: builder.enable_decomposition,
      enable_rewrite: builder.enable_rewrite,
      max_variants: builder.max_variants
    }
  };
}

pub fun transform_query(transformer, query_text) {
  let queries = [query_text];
  let log = [];

  if (transformer.enable_rewrite) {
    let rewritten = rewrite_query(transformer.llm, query_text);
    queries = [rewritten];
    push(log, { kind: "Rewrite", value: rewritten });
  }

  if (transformer.enable_expansion) {
    let expansions = expand_query(transformer.llm, query_text, transformer.max_variants);
    queries = concat(queries, expansions);
    push(log, { kind: "Expansion", value: expansions });
  }

  if (transformer.enable_decomposition) {
    let decomposed = decompose_query(transformer.llm, query_text, transformer.max_variants);
    queries = concat(queries, decomposed);
    push(log, { kind: "Decomposition", value: decomposed });
  }

  return {
    original: query_text,
    queries: dedupe_queries(queries),
    log: log
  };
}

pub fun expand_query(llm, query_text, max_variants) {
  let prompt = "Expand this query into " + str(max_variants) + " related search queries. One per line.\n\nQuery: " + query_text + "\n\nExpanded queries:";
  let response = llm.generate(prompt);
  let lines = split(response, "\n");
  let results = [];

  for (line in lines) {
    let cleaned = trim(regex_replace(line, "^[-\\d.]+\\s*", ""));
    if (len(cleaned) > 0) {
      push(results, cleaned);
    }
  }

  return take(results, max_variants);
}

pub fun decompose_query(llm, query_text, max_variants) {
  let prompt = "Break down this question into simpler sub-questions (one per line).\n\nQuestion: " + query_text + "\n\nSub-questions:";
  let response = llm.generate(prompt);
  let lines = split(response, "\n");
  let results = [];

  for (line in lines) {
    let cleaned = trim(regex_replace(line, "^[-\\d.]+\\s*", ""));
    if (len(cleaned) > 0) {
      push(results, cleaned);
    }
  }

  return take(results, max_variants);
}

pub fun rewrite_query(llm, query_text) {
  let prompt = "Rewrite this query to be precise and retrieval-focused.\n\nQuery: " + query_text + "\n\nRewritten query:";
  let response = trim(llm.generate(prompt));
  return len(response) > 0 ? response : query_text;
}

fun dedupe_queries(queries) {
  let seen = {};
  let unique = [];
  for (query in queries) {
    let key = lowercase(trim(query));
    if (seen[key] == nil) {
      seen[key] = true;
      push(unique, query);
    }
  }
  return unique;
}
