// Corrective RAG (CRAG)

module std.rag.advanced.crag;

use std.rag.error;
use std.rag.retriever;

let DEFAULT_GRADER_PROMPT = "You are a grader assessing the relevance of a retrieved document to a user question.\n\nDocument:\n{document}\n\nQuestion: {question}\n\nIs this document relevant to answering the question? Respond with only 'yes' or 'no'.";

pub fun grade_correct() { return { kind: "Correct" }; }
pub fun grade_incorrect() { return { kind: "Incorrect" }; }
pub fun grade_ambiguous() { return { kind: "Ambiguous" }; }

pub fun crag_config(grader_llm) {
  return {
    grader_llm: grader_llm,
    grader_prompt: DEFAULT_GRADER_PROMPT,
    relevance_threshold: 0.7,
    enable_web_search: true,
    web_search_fn: nil,
    max_corrections: 2,
    decompose_query: true
  };
}

pub fun with_grader_prompt(config, prompt) {
  config.grader_prompt = prompt;
  return config;
}

pub fun with_relevance_threshold(config, threshold) {
  config.relevance_threshold = threshold;
  return config;
}

pub fun with_web_search(config, enabled, search_fn) {
  config.enable_web_search = enabled;
  config.web_search_fn = search_fn;
  return config;
}

pub fun with_max_corrections(config, max) {
  config.max_corrections = max;
  return config;
}

pub fun crag_retriever_builder(base_retriever) {
  return {
    base_retriever: base_retriever,
    crag_config: nil
  };
}

pub fun with_crag_config(builder, config) {
  builder.crag_config = config;
  return builder;
}

pub fun build_crag_retriever(builder) {
  if (builder.crag_config == nil) {
    return { ok: false, error: error.config_error("crag_config", "CRAG config is required") };
  }

  return {
    ok: true,
    value: {
      kind: "CRAGRetriever",
      base_retriever: builder.base_retriever,
      crag_config: builder.crag_config
    }
  };
}

pub fun crag_retrieve(retriever_instance, query) {
  let config = retriever_instance.crag_config;

  let docs = retriever.retrieve(retriever_instance.base_retriever, query);

  let graded_docs = [];
  let relevant_count = 0;

  for (doc in docs) {
    let grade = grade_document(config.grader_llm, config.grader_prompt, query, doc);
    doc.grade = grade;
    push(graded_docs, doc);

    if (grade.kind == "Correct") {
      relevant_count = relevant_count + 1;
    }
  }

  let relevance_ratio = relevant_count / len(docs);

  let final_docs = graded_docs;
  let action_taken = "none";

  if (relevance_ratio < config.relevance_threshold) {
    if (config.enable_web_search && config.web_search_fn != nil) {
      let web_results = config.web_search_fn(query);
      final_docs = merge_docs(graded_docs, web_results);
      action_taken = "web_search";
    } else if (config.decompose_query) {
      let sub_queries = decompose_query(config.grader_llm, query);
      let additional_docs = [];

      for (sub_query in sub_queries) {
        let sub_docs = retriever.retrieve(retriever_instance.base_retriever, sub_query);
        additional_docs = merge_docs(additional_docs, sub_docs);
      }

      final_docs = merge_docs(graded_docs, additional_docs);
      action_taken = "query_decomposition";
    }
  }

  let filtered_docs = filter(final_docs, fun(d) {
    d.grade == nil || d.grade.kind == "Correct" || d.grade.kind == "Ambiguous"
  });

  return {
    documents: filtered_docs,
    original_relevance: relevance_ratio,
    action_taken: action_taken,
    grading_results: graded_docs
  };
}

fun grade_document(llm, prompt_template, query, doc) {
  let prompt = prompt_template;
  prompt = replace(prompt, "{document}", doc.content);
  prompt = replace(prompt, "{question}", query);

  let response = llm.generate(prompt);
  let response_lower = lowercase(trim(response));

  if (starts_with(response_lower, "yes")) {
    return grade_correct();
  }
  if (starts_with(response_lower, "no")) {
    return grade_incorrect();
  }
  return grade_ambiguous();
}

fun decompose_query(llm, query) {
  let prompt = "Break down this complex question into 2-3 simpler sub-questions:\n\nQuestion: " + query + "\n\nSub-questions (one per line):";
  let response = llm.generate(prompt);
  let lines = split(response, "\n");
  let sub_queries = [];

  for (line in lines) {
    let cleaned = trim(line);
    if (len(cleaned) > 10) {
      cleaned = regex_replace(cleaned, "^\\d+\\.\\s*", "");
      push(sub_queries, cleaned);
    }
  }

  return take(sub_queries, 3);
}

fun merge_docs(docs_a, docs_b) {
  let seen = {};
  let merged = [];

  for (doc in docs_a) {
    if (seen[doc.id] == nil) {
      seen[doc.id] = true;
      push(merged, doc);
    }
  }

  for (doc in docs_b) {
    if (seen[doc.id] == nil) {
      seen[doc.id] = true;
      push(merged, doc);
    }
  }

  return merged;
}
