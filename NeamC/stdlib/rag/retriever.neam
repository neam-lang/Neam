// RAG retriever implementations

module std.rag.retriever;

use std.ingest.store;
use std.rag.document;
use std.rag.error;

// Search types
pub fun search_type_similarity() {
  return { kind: "Similarity" };
}

pub fun search_type_mmr(lambda) {
  return { kind: "MMR", lambda: lambda };
}

pub fun search_type_threshold(min_score) {
  return { kind: "Threshold", min_score: min_score };
}

pub fun search_type_hybrid(keyword_weight, vector_weight) {
  return {
    kind: "Hybrid",
    keyword_weight: keyword_weight,
    vector_weight: vector_weight,
    fusion_method: "rrf"
  };
}

pub fun search_type_hybrid_weighted(keyword_weight, vector_weight) {
  return {
    kind: "Hybrid",
    keyword_weight: keyword_weight,
    vector_weight: vector_weight,
    fusion_method: "weighted"
  };
}

// Retriever builder
pub fun retriever_builder(vector_store) {
  return {
    store: vector_store,
    top_k: 4,
    threshold: 0.0,
    search_type: search_type_similarity(),
    embedder: nil,
    filters: [],
    include_metadata: true
  };
}

pub fun with_top_k(builder, k) {
  builder.top_k = k;
  return builder;
}

pub fun with_threshold(builder, threshold) {
  builder.threshold = threshold;
  return builder;
}

pub fun with_search_type(builder, search_type) {
  builder.search_type = search_type;
  return builder;
}

pub fun with_embedder(builder, embedder) {
  builder.embedder = embedder;
  return builder;
}

pub fun with_filter(builder, filter) {
  push(builder.filters, filter);
  return builder;
}

pub fun with_metadata(builder, include) {
  builder.include_metadata = include;
  return builder;
}

pub fun build_retriever(builder) {
  if (builder.store == nil) {
    return { ok: false, error: error.config_error("store", "Vector store is required") };
  }
  if (builder.embedder == nil) {
    return { ok: false, error: error.config_error("embedder", "Embedder is required") };
  }
  return {
    ok: true,
    value: {
      kind: "Retriever",
      store: builder.store,
      top_k: builder.top_k,
      threshold: builder.threshold,
      search_type: builder.search_type,
      embedder: builder.embedder,
      filters: builder.filters,
      include_metadata: builder.include_metadata
    }
  };
}

// Retrieval operations
pub fun retrieve(retriever, query_text) {
  let query_embedding = retriever.embedder.embed(query_text);
  let store_query = store.query(query_embedding, retriever.top_k);

  for (filter in retriever.filters) {
    store_query = store.with_filter(store_query, filter);
  }

  if (retriever.threshold > 0.0) {
    store_query = store.with_min_score(store_query, retriever.threshold);
  }

  store_query = store.with_metadata(store_query, retriever.include_metadata);

  let results = execute_search(retriever, store_query);
  return results_to_documents(results, retriever.include_metadata);
}

pub fun retrieve_with_sources(retriever, query_text) {
  let docs = retrieve(retriever, query_text);
  return {
    documents: docs,
    query: query_text,
    retriever_config: {
      top_k: retriever.top_k,
      threshold: retriever.threshold,
      search_type: retriever.search_type.kind
    }
  };
}

fun execute_search(retriever, query) {
  if (retriever.search_type.kind == "Similarity") {
    return retriever.store.search(query);
  }
  if (retriever.search_type.kind == "MMR") {
    return retriever.store.mmr_search(query, retriever.search_type.lambda);
  }
  if (retriever.search_type.kind == "Threshold") {
    return retriever.store.search(query);
  }
  return retriever.store.search(query);
}

pub fun results_to_documents(results, include_metadata) {
  let docs = [];
  for (result in results) {
    let content = result.content;
    if (content == nil && result.metadata != nil) {
      content = result.metadata.content;
    }
    let doc = document.rag_document(result.id, content, include_metadata ? result.metadata : {});
    doc = document.with_score(doc, result.score);
    push(docs, doc);
  }
  return docs;
}

// Phase 12 integration
pub fun retriever_from_ingest_store(ingest_store) {
  return {
    kind: "IngestStore",
    store: ingest_store,
    adapter: ingest_store_adapter(ingest_store)
  };
}

pub fun ingest_store_adapter(store_instance) {
  return {
    search: fun(query_vec, top_k, filter) {
      let q = store.query(query_vec, top_k);
      if (filter != nil) {
        q = store.with_filter(q, filter);
      }
      return store_instance.search(q);
    },
    upsert: fun(items) {
      return store_instance.upsert(items);
    }
  };
}

pub fun chunks_to_rag_documents(chunks) {
  let docs = [];
  for (chunk in chunks) {
    let doc = document.rag_document(chunk.id, chunk.content, {
      document_id: chunk.document_id,
      chunk_index: chunk.chunk_meta.index,
      page: chunk.chunk_meta.page,
      section_path: chunk.chunk_meta.section_path
    });
    push(docs, doc);
  }
  return docs;
}

// Hybrid retriever
pub fun hybrid_retriever_builder(vector_store, keyword_index) {
  return {
    vector_store: vector_store,
    keyword_index: keyword_index,
    top_k: 10,
    final_k: 4,
    keyword_weight: 0.3,
    vector_weight: 0.7,
    fusion_method: "rrf",
    embedder: nil
  };
}

pub fun with_keyword_weight(builder, weight) {
  builder.keyword_weight = weight;
  return builder;
}

pub fun with_vector_weight(builder, weight) {
  builder.vector_weight = weight;
  return builder;
}

pub fun with_fusion_method(builder, method) {
  builder.fusion_method = method;
  return builder;
}

pub fun with_final_k(builder, k) {
  builder.final_k = k;
  return builder;
}

pub fun build_hybrid_retriever(builder) {
  if (builder.vector_store == nil) {
    return { ok: false, error: error.config_error("vector_store", "Vector store is required") };
  }
  if (builder.keyword_index == nil) {
    return { ok: false, error: error.config_error("keyword_index", "Keyword index is required") };
  }
  if (builder.embedder == nil) {
    return { ok: false, error: error.config_error("embedder", "Embedder is required") };
  }
  return {
    ok: true,
    value: {
      kind: "HybridRetriever",
      vector_store: builder.vector_store,
      keyword_index: builder.keyword_index,
      top_k: builder.top_k,
      final_k: builder.final_k,
      keyword_weight: builder.keyword_weight,
      vector_weight: builder.vector_weight,
      fusion_method: builder.fusion_method,
      embedder: builder.embedder
    }
  };
}

pub fun hybrid_retrieve(retriever, query_text) {
  let query_embedding = retriever.embedder.embed(query_text);
  let vector_results = retriever.vector_store.search(
    store.query(query_embedding, retriever.top_k)
  );

  let keyword_results = retriever.keyword_index.search(query_text, retriever.top_k);

  let fused = fuse_results(
    vector_results,
    keyword_results,
    retriever.fusion_method,
    retriever.keyword_weight,
    retriever.vector_weight
  );

  return take(fused, retriever.final_k);
}

fun fuse_results(vector_results, keyword_results, method, kw_weight, vec_weight) {
  if (method == "rrf") {
    return reciprocal_rank_fusion(vector_results, keyword_results);
  }
  if (method == "weighted") {
    return weighted_fusion(vector_results, keyword_results, kw_weight, vec_weight);
  }
  return reciprocal_rank_fusion(vector_results, keyword_results);
}

fun reciprocal_rank_fusion(results_a, results_b) {
  let k = 60;
  let scores = {};

  for (i, result in enumerate(results_a)) {
    let id = result.id;
    scores[id] = (scores[id] || 0) + 1.0 / (k + i + 1);
    scores[id + "_doc"] = result;
  }

  for (i, result in enumerate(results_b)) {
    let id = result.id;
    scores[id] = (scores[id] || 0) + 1.0 / (k + i + 1);
    if (scores[id + "_doc"] == nil) {
      scores[id + "_doc"] = result;
    }
  }

  let combined = [];
  for (id in keys(scores)) {
    if (!ends_with(id, "_doc")) {
      push(combined, {
        id: id,
        score: scores[id],
        document: scores[id + "_doc"]
      });
    }
  }

  return sort_by(combined, fun(a, b) { b.score - a.score });
}

fun weighted_fusion(results_a, results_b, kw_weight, vec_weight) {
  let scores = {};

  for (i, result in enumerate(results_a)) {
    let id = result.id;
    let weight = vec_weight * (1.0 / (i + 1));
    scores[id] = (scores[id] || 0) + weight;
    scores[id + "_doc"] = result;
  }

  for (i, result in enumerate(results_b)) {
    let id = result.id;
    let weight = kw_weight * (1.0 / (i + 1));
    scores[id] = (scores[id] || 0) + weight;
    if (scores[id + "_doc"] == nil) {
      scores[id + "_doc"] = result;
    }
  }

  let combined = [];
  for (id in keys(scores)) {
    if (!ends_with(id, "_doc")) {
      push(combined, {
        id: id,
        score: scores[id],
        document: scores[id + "_doc"]
      });
    }
  }

  return sort_by(combined, fun(a, b) { b.score - a.score });
}
