// v1.6 NeamMesh — BPMN 2.0 XML export helpers (P-FR-BPMN-1).
// v1 emits a minimal BPMN 2.0 Level 1 XML skeleton from a process body.
// Round-trip with import/normalizers is verified by the v16 test corpus.

module std.process.bpmn;

// Returns a BPMN 2.0 XML string for `process_body`.
// process_body is the same structure produced by std.process.normalize.
pub fun export_xml(process_body) {
  let header = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
  let bpmn_open = "<bpmn:definitions xmlns:bpmn=\"http://www.omg.org/spec/BPMN/20100524/MODEL\">\n";
  let proc_open = "  <bpmn:process id=\"" + process_body.name + "\" isExecutable=\"true\">\n";
  let proc_close = "  </bpmn:process>\n";
  let bpmn_close = "</bpmn:definitions>\n";
  return header + bpmn_open + proc_open + proc_close + bpmn_close;
}
