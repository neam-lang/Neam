// Speech event wrappers

module std.speech.events;

pub fun transcript_event(text, confidence, is_final, timestamp) {
  return {
    kind: "Transcript",
    text: text,
    confidence: confidence,
    is_final: is_final,
    timestamp: timestamp
  };
}

pub fun audio_event(frame, timestamp) {
  return {
    kind: "Audio",
    frame: frame,
    timestamp: timestamp
  };
}
