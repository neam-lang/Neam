// Metadata utilities for vector ingestion

module std.ingest.metadata;

// Create an empty metadata map
pub fun metadata_map() {
  return {
    values: {},
    tags: [],
    entities: []
  };
}

// Add a key-value pair to metadata
pub fun with_value(meta, key, value) {
  meta.values[key] = value;
  return meta;
}

// Add multiple key-value pairs
pub fun with_values(meta, entries) {
  for (entry in entries) {
    meta.values[entry.key] = entry.value;
  }
  return meta;
}

// Add tags to metadata
pub fun with_tags(meta, tags) {
  for (tag in tags) {
    push(meta.tags, tag);
  }
  return meta;
}

// Add entities to metadata
pub fun with_entities(meta, entities) {
  for (entity in entities) {
    push(meta.entities, entity);
  }
  return meta;
}

// Extract metadata from a document
pub fun from_document(doc) {
  let meta = metadata_map();
  if (doc.metadata != nil) {
    if (doc.metadata.title != nil) {
      meta = with_value(meta, "title", doc.metadata.title);
    }
    if (doc.metadata.author != nil) {
      meta = with_value(meta, "author", doc.metadata.author);
    }
    if (doc.metadata.language != nil) {
      meta = with_value(meta, "language", doc.metadata.language);
    }
    if (doc.metadata.mime_type != nil) {
      meta = with_value(meta, "mime_type", doc.metadata.mime_type);
    }
    if (doc.metadata.entities != nil) {
      meta = with_entities(meta, doc.metadata.entities);
    }
    if (doc.metadata.keywords != nil) {
      meta = with_tags(meta, doc.metadata.keywords);
    }
  }
  return meta;
}
