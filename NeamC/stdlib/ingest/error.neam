// Ingestion error helpers

module std.ingest.error;

// Source errors
pub fun source_error_not_found(uri) { return { kind: "NotFound", uri: uri }; }
pub fun source_error_access_denied(uri) { return { kind: "AccessDenied", uri: uri }; }
pub fun source_error_connection_failed(message) { return { kind: "ConnectionFailed", message: message }; }
pub fun source_error_invalid_credentials() { return { kind: "InvalidCredentials" }; }
pub fun source_error_timeout() { return { kind: "Timeout" }; }

// Parse errors
pub fun parse_error_unsupported_format(mime_type) { return { kind: "UnsupportedFormat", mime_type: mime_type }; }
pub fun parse_error_corrupted_file(message) { return { kind: "CorruptedFile", message: message }; }
pub fun parse_error_password_protected() { return { kind: "PasswordProtected" }; }
pub fun parse_error_too_large(size, max_size) { return { kind: "TooLarge", size: size, max_size: max_size }; }
pub fun parse_error_encoding(message) { return { kind: "EncodingError", message: message }; }

// Embed errors
pub fun embed_error_provider(message) { return { kind: "ProviderError", message: message }; }
pub fun embed_error_rate_limited(retry_after_ms) { return { kind: "RateLimited", retry_after_ms: retry_after_ms }; }
pub fun embed_error_invalid_input(message) { return { kind: "InvalidInput", message: message }; }
pub fun embed_error_timeout() { return { kind: "Timeout" }; }

// Store errors
pub fun store_error_connection_failed(message) { return { kind: "ConnectionFailed", message: message }; }
pub fun store_error_index_not_found(name) { return { kind: "IndexNotFound", name: name }; }
pub fun store_error_invalid_dimensions(expected, got) { return { kind: "InvalidDimensions", expected: expected, got: got }; }
pub fun store_error_quota_exceeded() { return { kind: "QuotaExceeded" }; }
pub fun store_error_timeout() { return { kind: "Timeout" }; }

// Ingest errors (top-level)
pub fun ingest_error_source(source_name, error) {
  return { kind: "Source", source_name: source_name, error: error };
}

pub fun ingest_error_parse(document_id, mime_type, error) {
  return { kind: "Parse", document_id: document_id, mime_type: mime_type, error: error };
}

pub fun ingest_error_transform(document_id, transform_name, error) {
  return { kind: "Transform", document_id: document_id, transform_name: transform_name, error: error };
}

pub fun ingest_error_chunk(document_id, error) {
  return { kind: "Chunk", document_id: document_id, error: error };
}

pub fun ingest_error_embed(chunk_ids, error) {
  return { kind: "Embed", chunk_ids: chunk_ids, error: error };
}

pub fun ingest_error_store(operation, error) {
  return { kind: "Store", operation: operation, error: error };
}

pub fun ingest_error_config(field, error) {
  return { kind: "Config", field: field, error: error };
}

pub fun ingest_error_rate_limit(provider, retry_after_ms) {
  return { kind: "RateLimit", provider: provider, retry_after_ms: retry_after_ms };
}

pub fun ingest_error_timeout(stage, timeout_ms) {
  return { kind: "Timeout", stage: stage, timeout_ms: timeout_ms };
}
