// Vector ingestion pipeline orchestration helpers

module std.ingest.pipeline;

pub fun builder(name) {
  return {
    name: name,
    sources: [],
    parser_registry: nil,
    chunker: nil,
    embedder: nil,
    store: nil,
    transforms: [],
    config: nil,
    status: status_idle()
  };
}

pub fun with_source(builder, source) {
  push(builder.sources, source);
  return builder;
}

pub fun with_sources(builder, sources) {
  for (source in sources) {
    push(builder.sources, source);
  }
  return builder;
}

pub fun with_parser(builder, extension, parser) {
  if (builder.parser_registry == nil) {
    builder.parser_registry = parser_registry();
  }
  builder.parser_registry = register_parser(builder.parser_registry, extension, parser);
  return builder;
}

pub fun with_parser_registry(builder, registry) {
  builder.parser_registry = registry;
  return builder;
}

pub fun with_chunker(builder, chunker) {
  builder.chunker = chunker;
  return builder;
}

pub fun with_embedder(builder, embedder) {
  builder.embedder = embedder;
  return builder;
}

pub fun with_store(builder, store) {
  builder.store = store;
  return builder;
}

pub fun with_transform(builder, transform) {
  push(builder.transforms, transform);
  return builder;
}

pub fun with_config(builder, config) {
  builder.config = config;
  return builder;
}

pub fun build(builder) {
  if (len(builder.sources) == 0) {
    return { ok: false, error: config_error("sources", "At least one source required") };
  }
  if (builder.embedder == nil) {
    return { ok: false, error: config_error("embedder", "Embedder required") };
  }
  if (builder.store == nil) {
    return { ok: false, error: config_error("store", "Store required") };
  }

  if (builder.parser_registry == nil) {
    builder.parser_registry = default_registry();
  }
  if (builder.chunker == nil) {
    builder.chunker = recursive_for_text();
  }
  if (builder.config == nil) {
    builder.config = default_pipeline_config();
  }

  return {
    ok: true,
    value: {
      name: builder.name,
      sources: builder.sources,
      parser_registry: builder.parser_registry,
      chunker: builder.chunker,
      embedder: builder.embedder,
      store: builder.store,
      transforms: builder.transforms,
      config: builder.config,
      status: builder.status
    }
  };
}

pub fun status_idle() {
  return { kind: "Idle" };
}

pub fun status_running(progress, current_source) {
  return { kind: "Running", progress: progress, current_source: current_source };
}

pub fun status_completed(result) {
  return { kind: "Completed", result: result };
}

pub fun status_cancelled() {
  return { kind: "Cancelled" };
}

pub fun status_failed(error) {
  return { kind: "Failed", error: error };
}

pub fun status(pipeline) {
  return pipeline.status;
}

pub fun ingest_result(documents_processed, chunks_created, vectors_stored, documents_skipped, errors, duration_ms, cost, source_stats) {
  return {
    documents_processed: documents_processed,
    chunks_created: chunks_created,
    vectors_stored: vectors_stored,
    documents_skipped: documents_skipped,
    errors: errors,
    duration_ms: duration_ms,
    cost: cost,
    source_stats: source_stats
  };
}

pub fun cost_breakdown(embedding_cost_cents, storage_cost_cents, compute_cost_cents) {
  return {
    embedding_cost_cents: embedding_cost_cents,
    storage_cost_cents: storage_cost_cents,
    compute_cost_cents: compute_cost_cents,
    total_cost_cents: embedding_cost_cents + storage_cost_cents + compute_cost_cents
  };
}

pub fun source_stats(documents, chunks, bytes_processed, duration_ms, errors) {
  return {
    documents: documents,
    chunks: chunks,
    bytes_processed: bytes_processed,
    duration_ms: duration_ms,
    errors: errors
  };
}

pub fun progress_event(kind, source, processed, total, message) {
  return {
    kind: kind,
    source: source,
    processed: processed,
    total: total,
    message: message
  };
}

pub fun progress_kind_source_list() {
  return { kind: "SourceList" };
}

pub fun progress_kind_document_read() {
  return { kind: "DocumentRead" };
}

pub fun progress_kind_parsed() {
  return { kind: "Parsed" };
}

pub fun progress_kind_chunked() {
  return { kind: "Chunked" };
}

pub fun progress_kind_embedded() {
  return { kind: "Embedded" };
}

pub fun progress_kind_stored() {
  return { kind: "Stored" };
}

pub fun progress_kind_completed() {
  return { kind: "Completed" };
}

pub fun config_error(field, message) {
  return { kind: "Config", field: field, message: message };
}

pub fun ingest_error(kind, message, source, detail) {
  return { kind: kind, message: message, source: source, detail: detail };
}

pub fun ingest_error_source(message, source, detail) {
  return ingest_error("Source", message, source, detail);
}

pub fun ingest_error_parser(message, source, detail) {
  return ingest_error("Parser", message, source, detail);
}

pub fun ingest_error_chunker(message, source, detail) {
  return ingest_error("Chunker", message, source, detail);
}

pub fun ingest_error_embedder(message, source, detail) {
  return ingest_error("Embedder", message, source, detail);
}

pub fun ingest_error_store(message, source, detail) {
  return ingest_error("Store", message, source, detail);
}

pub fun ingest_error_transform(message, source, detail) {
  return ingest_error("Transform", message, source, detail);
}

pub fun ingest_error_cancelled(message) {
  return ingest_error("Cancelled", message, nil, nil);
}

pub fun ingest_error_unimplemented(operation) {
  return ingest_error("Unimplemented", "Operation not implemented: " + operation, nil, nil);
}

pub fun run(pipeline) {
  return { ok: false, error: ingest_error_unimplemented("run") };
}

pub fun run_source(pipeline, source) {
  return { ok: false, error: ingest_error_unimplemented("run_source") };
}

pub fun run_incremental(pipeline) {
  return { ok: false, error: ingest_error_unimplemented("run_incremental") };
}

pub fun cancel(pipeline) {
  pipeline.status = status_cancelled();
  return pipeline;
}
