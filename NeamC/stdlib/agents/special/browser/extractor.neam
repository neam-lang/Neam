// Browser extractor

module std.agents.special.browser.extractor;

// === Extractor ===

pub fun create(config) {
  return {
    llm: config.llm,
    use_vision: config.use_vision
  };
}

// === Extraction Operations ===

pub fun extract_text(extractor, page, selector) {
  if (selector == nil) {
    return native.page_evaluate(page, "document.body.innerText");
  }

  let element = native.page_query_selector(page, selector);
  if (element == nil) {
    return { ok: false, error: { kind: "ElementNotFound", selector: selector } };
  }

  let text = native.element_inner_text(element);
  return { ok: true, value: text };
}

pub fun extract_table(extractor, page, selector) {
  let table = native.page_query_selector(page, selector);
  if (table == nil) {
    return { ok: false, error: { kind: "TableNotFound", selector: selector } };
  }

  let headers = [];
  let rows = [];

  let header_cells = native.element_query_selector_all(table, "th");
  for (cell in header_cells) {
    push(headers, native.element_inner_text(cell));
  }

  let row_elements = native.element_query_selector_all(table, "tr");
  for (row in row_elements) {
    let cells = native.element_query_selector_all(row, "td");
    if (len(cells) > 0) {
      let row_data = [];
      for (cell in cells) {
        push(row_data, native.element_inner_text(cell));
      }
      push(rows, row_data);
    }
  }

  return {
    ok: true,
    value: {
      headers: headers,
      rows: rows,
      row_count: len(rows)
    }
  };
}

pub fun extract_links(extractor, page, selector) {
  let base_selector = selector || "a[href]";
  let elements = native.page_query_selector_all(page, base_selector);

  let links = [];
  for (el in elements) {
    let href = native.element_get_attribute(el, "href");
    let text = native.element_inner_text(el);
    if (href != nil) {
      push(links, { url: href, text: text });
    }
  }

  return { ok: true, value: links };
}

pub fun extract_structured(extractor, page, schema) {
  let page_text = native.page_evaluate(page, "document.body.innerText");

  let prompt = "Extract structured data from the following web page content according to this schema:\n\nSchema: " + json_stringify(schema) + "\n\nPage Content:\n" + take(page_text, 5000) + "\n\nExtracted JSON:";

  let response = extractor.llm.generate(prompt);
  let extracted = json_parse(response);

  return { ok: true, value: extracted };
}

pub fun extract_images(extractor, page, selector) {
  let base_selector = selector || "img[src]";
  let elements = native.page_query_selector_all(page, base_selector);

  let images = [];
  for (el in elements) {
    let src = native.element_get_attribute(el, "src");
    let alt = native.element_get_attribute(el, "alt");
    if (src != nil) {
      push(images, { url: src, alt: alt });
    }
  }

  return { ok: true, value: images };
}
