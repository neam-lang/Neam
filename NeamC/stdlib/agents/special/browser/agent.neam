// Browser agent implementation

module std.agents.special.browser.agent;

use std.agents.special.base;
use std.agents.special.browser.navigator;
use std.agents.special.browser.extractor;
use std.agents.special.browser.automator;
use std.agents.special.browser.config;

// === Type Constructors ===

pub fun browser_agent(config) {
  return {
    kind: "BrowserAgent",
    config: config,
    navigator: navigator.create(config),
    extractor: extractor.create(config),
    automator: automator.create(config),
    browser_instance: nil,
    current_page: nil,
    page_context: nil,
    action_history: []
  };
}

// === Builder Pattern ===

pub fun browser_builder(llm) {
  return {
    llm: llm,
    browser_type: config.browser_type_chromium(),
    headless: true,
    viewport: { width: 1280, height: 720 },
    user_agent: nil,
    timeout_ms: 30000,
    screenshot_on_action: false,
    use_accessibility_tree: true,
    use_vision: false,
    max_retries: 3,
    guards: [],
    blocked_domains: [],
    allowed_domains: [],
    budget: nil
  };
}

pub fun with_browser_type(builder, browser_type) {
  builder.browser_type = browser_type;
  return builder;
}

pub fun with_headless(builder, headless) {
  builder.headless = headless;
  return builder;
}

pub fun with_viewport(builder, width, height) {
  builder.viewport = { width: width, height: height };
  return builder;
}

pub fun with_user_agent(builder, user_agent) {
  builder.user_agent = user_agent;
  return builder;
}

pub fun with_timeout(builder, timeout_ms) {
  builder.timeout_ms = timeout_ms;
  return builder;
}

pub fun with_screenshots(builder, enabled) {
  builder.screenshot_on_action = enabled;
  return builder;
}

pub fun with_accessibility_tree(builder, enabled) {
  builder.use_accessibility_tree = enabled;
  return builder;
}

pub fun with_vision(builder, enabled) {
  builder.use_vision = enabled;
  return builder;
}

pub fun with_max_retries(builder, max) {
  builder.max_retries = max;
  return builder;
}

pub fun with_blocked_domains(builder, domains) {
  builder.blocked_domains = domains;
  return builder;
}

pub fun with_allowed_domains(builder, domains) {
  builder.allowed_domains = domains;
  return builder;
}

pub fun build_browser_agent(builder) {
  if (builder.llm == nil) {
    return { ok: false, error: config.browser_error("llm", "LLM is required") };
  }

  let agent_config = config.browser_config(
    builder.llm,
    builder.browser_type,
    builder.headless,
    builder.viewport,
    builder.user_agent,
    builder.timeout_ms,
    builder.screenshot_on_action,
    builder.use_accessibility_tree,
    builder.use_vision,
    builder.max_retries,
    builder.guards,
    builder.blocked_domains,
    builder.allowed_domains,
    builder.budget
  );

  return { ok: true, value: browser_agent(agent_config) };
}

// === Browser Lifecycle ===

pub fun launch(agent) {
  let browser_result = native.browser_launch({
    type: agent.config.browser_type.kind,
    headless: agent.config.headless,
    viewport: agent.config.viewport,
    user_agent: agent.config.user_agent
  });

  if (!browser_result.ok) {
    return { ok: false, error: config.browser_error("launch", browser_result.error) };
  }

  agent.browser_instance = browser_result.value;
  return { ok: true, value: agent };
}

pub fun close(agent) {
  if (agent.browser_instance != nil) {
    native.browser_close(agent.browser_instance);
    agent.browser_instance = nil;
    agent.current_page = nil;
    agent.page_context = nil;
  }
  return agent;
}

// === Navigation ===

pub fun goto(agent, url) {
  if (!is_allowed_domain(url, agent.config)) {
    return { ok: false, error: config.domain_blocked_error(url) };
  }

  let nav_result = navigator.goto(agent.navigator, agent.browser_instance, url);
  if (!nav_result.ok) {
    return nav_result;
  }

  agent.current_page = nav_result.value.page;
  agent.page_context = capture_context(agent);
  record_action(agent, action_goto(url));

  return { ok: true, value: agent.page_context };
}

pub fun click(agent, selector_or_text) {
  let element = find_element(agent, selector_or_text);
  if (element == nil) {
    return { ok: false, error: config.element_not_found_error(selector_or_text) };
  }

  let click_result = navigator.click(agent.navigator, agent.current_page, element);
  if (click_result.ok) {
    agent.page_context = capture_context(agent);
    record_action(agent, action_click(selector_or_text));
  }
  return click_result;
}

pub fun type_text(agent, selector_or_text, text) {
  let element = find_element(agent, selector_or_text);
  if (element == nil) {
    return { ok: false, error: config.element_not_found_error(selector_or_text) };
  }

  let type_result = navigator.type_text(agent.navigator, agent.current_page, element, text);
  if (type_result.ok) {
    record_action(agent, action_type(selector_or_text, text));
  }
  return type_result;
}

pub fun scroll(agent, direction, amount) {
  let scroll_result = navigator.scroll(agent.navigator, agent.current_page, direction, amount);
  if (scroll_result.ok) {
    agent.page_context = capture_context(agent);
    record_action(agent, action_scroll(direction, amount));
  }
  return scroll_result;
}

pub fun wait_for(agent, selector_or_condition, timeout_ms) {
  return navigator.wait_for(agent.navigator, agent.current_page, selector_or_condition, timeout_ms);
}

// === Extraction ===

pub fun extract_text(agent, selector) {
  return extractor.extract_text(agent.extractor, agent.current_page, selector);
}

pub fun extract_table(agent, selector) {
  return extractor.extract_table(agent.extractor, agent.current_page, selector);
}

pub fun extract_links(agent, selector) {
  return extractor.extract_links(agent.extractor, agent.current_page, selector);
}

pub fun extract_structured(agent, schema) {
  return extractor.extract_structured(agent.extractor, agent.current_page, schema);
}

pub fun screenshot(agent) {
  return navigator.screenshot(agent.navigator, agent.current_page);
}

// === Natural Language Interface ===

pub fun execute(agent, instruction) {
  let plan = plan_actions(agent, instruction);

  let results = [];
  for (action in plan.actions) {
    let result = execute_action(agent, action);
    push(results, result);

    if (!result.ok && !action.optional) {
      return {
        ok: false,
        error: config.execution_error(instruction, result.error),
        partial_results: results
      };
    }
  }

  return { ok: true, value: { instruction: instruction, results: results } };
}

pub fun ask(agent, question) {
  let context = format_page_context(agent.page_context);
  let prompt = "Based on the following web page content, answer the question.\n\nPage Content:\n" + context + "\n\nQuestion: " + question + "\n\nAnswer:";

  let answer = agent.config.llm.generate(prompt);
  return { ok: true, value: answer };
}

// === Workflow Execution ===

pub fun run_workflow(agent, workflow) {
  return automator.run_workflow(agent.automator, agent, workflow);
}

pub fun fill_form(agent, form_data) {
  return automator.fill_form(agent.automator, agent, form_data);
}

// === Context Capture ===

pub fun capture_context(agent) {
  let context = {
    url: native.page_url(agent.current_page),
    title: native.page_title(agent.current_page),
    content: nil,
    accessibility_tree: nil,
    screenshot: nil,
    captured_at: now()
  };

  if (agent.config.use_accessibility_tree) {
    context.accessibility_tree = native.page_accessibility_tree(agent.current_page);
  } else {
    context.content = native.page_content(agent.current_page);
  }

  if (agent.config.screenshot_on_action) {
    context.screenshot = navigator.screenshot(agent.navigator, agent.current_page).value;
  }

  return context;
}

// === Element Finding ===

pub fun find_element(agent, selector_or_text) {
  let by_selector = navigator.query_selector(agent.navigator, agent.current_page, selector_or_text);
  if (by_selector != nil) {
    return by_selector;
  }

  if (agent.config.use_accessibility_tree && agent.page_context.accessibility_tree != nil) {
    let by_a11y = find_in_accessibility_tree(agent.page_context.accessibility_tree, selector_or_text);
    if (by_a11y != nil) {
      return by_a11y;
    }
  }

  let by_llm = find_element_with_llm(agent, selector_or_text);
  return by_llm;
}

pub fun plan_actions(agent, instruction) {
  let context_summary = summarize_page_context(agent.page_context);

  let prompt = "Given the following web page and instruction, plan the browser actions needed.\n\nPage: " + context_summary + "\n\nInstruction: " + instruction + "\n\nReturn a JSON list of actions with format: [{\"action\": \"click|type|scroll|wait|extract\", \"target\": \"...\", \"value\": \"...\"}]";

  let response = agent.config.llm.generate(prompt);
  let actions = json_parse(response);

  return { actions: actions };
}

// === Action Types ===

pub fun action_goto(url) { return { kind: "Goto", url: url, timestamp: now() }; }
pub fun action_click(target) { return { kind: "Click", target: target, timestamp: now() }; }
pub fun action_type(target, text) { return { kind: "Type", target: target, text: text, timestamp: now() }; }
pub fun action_scroll(direction, amount) { return { kind: "Scroll", direction: direction, amount: amount, timestamp: now() }; }
pub fun action_wait(condition) { return { kind: "Wait", condition: condition, timestamp: now() }; }
pub fun action_extract(selector) { return { kind: "Extract", selector: selector, timestamp: now() }; }

pub fun record_action(agent, action) {
  push(agent.action_history, action);
}

// === Helpers ===

fun execute_action(agent, action) {
  if (action.action == "goto") {
    return goto(agent, action.target || action.url);
  }
  if (action.action == "click") {
    return click(agent, action.target);
  }
  if (action.action == "type") {
    return type_text(agent, action.target, action.value);
  }
  if (action.action == "scroll") {
    return scroll(agent, action.direction || "down", action.amount || 500);
  }
  if (action.action == "wait") {
    return wait_for(agent, action.target || action.condition, action.timeout);
  }
  if (action.action == "extract") {
    return extract_text(agent, action.target || action.selector);
  }
  return { ok: false, error: { kind: "UnknownAction", action: action.action } };
}

fun is_allowed_domain(url, config) {
  let host = extract_host(url);
  if (len(config.allowed_domains) > 0) {
    for (domain in config.allowed_domains) {
      if (ends_with(host, domain)) {
        return true;
      }
    }
    return false;
  }

  for (domain in config.blocked_domains) {
    if (ends_with(host, domain)) {
      return false;
    }
  }

  return true;
}

fun extract_host(url) {
  let without_protocol = replace(replace(url, "https://", ""), "http://", "");
  let parts = split(without_protocol, "/");
  return parts[0];
}

fun summarize_page_context(context) {
  if (context == nil) { return "No page loaded"; }
  let summary = "URL: " + context.url + "\nTitle: " + context.title;
  if (context.content != nil) {
    summary = summary + "\nContent: " + take(context.content, 500);
  }
  return summary;
}

fun format_page_context(context) {
  if (context == nil) { return ""; }
  if (context.content != nil) { return take(context.content, 5000); }
  if (context.accessibility_tree != nil) {
    return json_stringify(context.accessibility_tree);
  }
  return "";
}

fun find_in_accessibility_tree(tree, selector_or_text) {
  if (tree == nil) { return nil; }
  if (tree.name != nil && contains(lowercase(tree.name), lowercase(selector_or_text))) {
    return tree.element;
  }
  if (tree.children != nil) {
    for (child in tree.children) {
      let found = find_in_accessibility_tree(child, selector_or_text);
      if (found != nil) { return found; }
    }
  }
  return nil;
}

fun find_element_with_llm(agent, selector_or_text) {
  let context_summary = summarize_page_context(agent.page_context);
  let prompt = "Given the page summary and target text, return a CSS selector that matches the element.\n\nSummary: " + context_summary + "\n\nTarget: " + selector_or_text + "\n\nSelector:";
  let response = agent.config.llm.generate(prompt);
  let selector = trim(response);
  if (selector == "") { return nil; }
  return navigator.query_selector(agent.navigator, agent.current_page, selector);
}
