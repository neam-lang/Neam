// RAG configuration helpers

module std.rag.config;

use std.rag.error;

pub fun rag_config() {
  return {
    retriever: nil,
    llm: nil,
    cache: nil,
    memory: nil,
    evaluator: nil,
    max_context_tokens: 4000,
    include_sources: true
  };
}

pub fun with_retriever(config, retriever) {
  config.retriever = retriever;
  return config;
}

pub fun with_llm(config, llm) {
  config.llm = llm;
  return config;
}

pub fun with_cache(config, cache) {
  config.cache = cache;
  return config;
}

pub fun with_memory(config, memory) {
  config.memory = memory;
  return config;
}

pub fun with_evaluator(config, evaluator) {
  config.evaluator = evaluator;
  return config;
}

pub fun with_max_context_tokens(config, max_tokens) {
  config.max_context_tokens = max_tokens;
  return config;
}

pub fun with_include_sources(config, include) {
  config.include_sources = include;
  return config;
}

pub fun build_config(config) {
  if (config.retriever == nil) {
    return { ok: false, error: error.config_error("retriever", "Retriever is required") };
  }
  if (config.llm == nil) {
    return { ok: false, error: error.config_error("llm", "LLM is required") };
  }
  return { ok: true, value: config };
}
