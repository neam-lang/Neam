// RAG error helpers

module std.rag.error;

pub fun config_error(field, message) {
  return { kind: "Config", field: field, message: message };
}

pub fun validation_error(field, message) {
  return { kind: "Validation", field: field, message: message };
}

pub fun retrieval_error(message, detail) {
  return { kind: "Retrieval", message: message, detail: detail };
}

pub fun chain_error(message, detail) {
  return { kind: "Chain", message: message, detail: detail };
}

pub fun cache_error(message, detail) {
  return { kind: "Cache", message: message, detail: detail };
}

pub fun evaluation_error(message, detail) {
  return { kind: "Evaluation", message: message, detail: detail };
}

pub fun not_supported(feature) {
  return { kind: "NotSupported", feature: feature };
}

pub fun missing_dependency(name) {
  return { kind: "MissingDependency", name: name };
}

pub fun unknown_error(message) {
  return { kind: "Unknown", message: message };
}
