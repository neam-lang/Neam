pub fun default_registry() {
  let registry = parser_registry();

  register_parser(registry, "txt", text_parser());
  register_parser(registry, "text", text_parser());
  register_parser(registry, "md", markdown_parser());
  register_parser(registry, "markdown", markdown_parser());
  register_parser(registry, "json", json_parser());
  register_parser(registry, "jsonl", json_parser());
  register_parser(registry, "csv", csv_parser());
  register_parser(registry, "tsv", with_delimiter(csv_parser(), "\t"));
  register_parser(registry, "html", html_parser());
  register_parser(registry, "htm", html_parser());

  return with_default_parser(registry, text_parser());
}

// Extended default parser registry with all parsers
pub fun full_registry() {
  let registry = default_registry();

  // Office documents
  registry = register_parser(registry, "pdf", pdf_parser());
  registry = register_parser(registry, "docx", docx_parser());
  registry = register_parser(registry, "doc", docx_parser());
  registry = register_parser(registry, "pptx", pptx_parser());
  registry = register_parser(registry, "ppt", pptx_parser());
  registry = register_parser(registry, "xlsx", xlsx_parser());
  registry = register_parser(registry, "xls", xlsx_parser());

  // Log files
  registry = register_parser(registry, "log", log_parser());
  registry = register_parser(registry, "logs", log_parser());

  // Code files
  registry = register_parser(registry, "py", code_parser());
  registry = register_parser(registry, "js", code_parser());
  registry = register_parser(registry, "ts", code_parser());
  registry = register_parser(registry, "tsx", code_parser());
  registry = register_parser(registry, "jsx", code_parser());
  registry = register_parser(registry, "rs", code_parser());
  registry = register_parser(registry, "go", code_parser());
  registry = register_parser(registry, "java", code_parser());
  registry = register_parser(registry, "c", code_parser());
  registry = register_parser(registry, "cpp", code_parser());
  registry = register_parser(registry, "h", code_parser());
  registry = register_parser(registry, "hpp", code_parser());
  registry = register_parser(registry, "rb", code_parser());
  registry = register_parser(registry, "php", code_parser());
  registry = register_parser(registry, "swift", code_parser());
  registry = register_parser(registry, "kt", code_parser());
  registry = register_parser(registry, "neam", code_parser());

  // Images
  registry = register_parser(registry, "png", image_parser());
  registry = register_parser(registry, "jpg", image_parser());
  registry = register_parser(registry, "jpeg", image_parser());
  registry = register_parser(registry, "gif", image_parser());
  registry = register_parser(registry, "webp", image_parser());
  registry = register_parser(registry, "bmp", image_parser());
  registry = register_parser(registry, "tiff", image_parser());

  // Audio
  registry = register_parser(registry, "mp3", audio_parser());
  registry = register_parser(registry, "wav", audio_parser());
  registry = register_parser(registry, "m4a", audio_parser());
  registry = register_parser(registry, "flac", audio_parser());
  registry = register_parser(registry, "ogg", audio_parser());

  // Video
  registry = register_parser(registry, "mp4", video_parser());
  registry = register_parser(registry, "mov", video_parser());
  registry = register_parser(registry, "avi", video_parser());
  registry = register_parser(registry, "mkv", video_parser());
  registry = register_parser(registry, "webm", video_parser());

  return registry;
}
