// Embedding providers and helpers

module std.ingest.embed;

// Rate limit info
pub fun rate_limit_info(requests_per_minute, tokens_per_minute) {
  return {
    requests_per_minute: requests_per_minute,
    tokens_per_minute: tokens_per_minute
  };
}

// Embedding result
pub fun embedding(vector, model, dimensions) {
  return {
    vector: vector,
    model: model,
    dimensions: dimensions
  };
}

// OpenAI embedding provider
pub fun openai_embedding(api_key) {
  return {
    kind: "OpenAI",
    api_key: api_key,
    model: "text-embedding-3-small",
    dimensions: nil,
    base_url: nil
  };
}

pub fun with_model(provider, model) {
  provider.model = model;
  return provider;
}

pub fun with_dimensions(provider, dims) {
  provider.dimensions = dims;
  return provider;
}

pub fun with_base_url(provider, url) {
  provider.base_url = url;
  return provider;
}

// OpenAI model shortcuts
pub fun openai_small(api_key) {
  return with_model(openai_embedding(api_key), "text-embedding-3-small");
}

pub fun openai_large(api_key) {
  return with_model(openai_embedding(api_key), "text-embedding-3-large");
}

pub fun openai_ada(api_key) {
  return with_model(openai_embedding(api_key), "text-embedding-ada-002");
}

// Cohere input types
pub fun cohere_input_search_document() { return { kind: "SearchDocument" }; }
pub fun cohere_input_search_query() { return { kind: "SearchQuery" }; }
pub fun cohere_input_classification() { return { kind: "Classification" }; }
pub fun cohere_input_clustering() { return { kind: "Clustering" }; }

// Cohere embedding provider
pub fun cohere_embedding(api_key) {
  return {
    kind: "Cohere",
    api_key: api_key,
    model: "embed-english-v3.0",
    input_type: cohere_input_search_document()
  };
}

pub fun with_input_type(provider, input_type) {
  provider.input_type = input_type;
  return provider;
}

// Cohere model shortcuts
pub fun cohere_english(api_key) {
  return with_model(cohere_embedding(api_key), "embed-english-v3.0");
}

pub fun cohere_multilingual(api_key) {
  return with_model(cohere_embedding(api_key), "embed-multilingual-v3.0");
}

// Voyage AI embedding provider
pub fun voyage_embedding(api_key) {
  return {
    kind: "Voyage",
    api_key: api_key,
    model: "voyage-2"
  };
}

pub fun voyage_large(api_key) {
  return with_model(voyage_embedding(api_key), "voyage-large-2");
}

pub fun voyage_code(api_key) {
  return with_model(voyage_embedding(api_key), "voyage-code-2");
}

// Device types
pub fun device_cpu() { return { kind: "CPU" }; }
pub fun device_cuda(device_id) { return { kind: "CUDA", device_id: device_id }; }
pub fun device_mps() { return { kind: "MPS" }; }

// Local embedding provider (sentence-transformers)
pub fun local_embedding(model_name) {
  return {
    kind: "Local",
    model_name: model_name,
    device: device_cpu(),
    batch_size: 32
  };
}

pub fun with_device(provider, device) {
  provider.device = device;
  return provider;
}

pub fun with_batch_size(provider, batch_size) {
  provider.batch_size = batch_size;
  return provider;
}

// Local model shortcuts
pub fun local_minilm() {
  return local_embedding("all-MiniLM-L6-v2");
}

pub fun local_bge_small() {
  return local_embedding("BAAI/bge-small-en-v1.5");
}

pub fun local_e5_small() {
  return local_embedding("intfloat/e5-small-v2");
}

// Ollama embedding provider
pub fun ollama_embedding(model) {
  return {
    kind: "Ollama",
    model: model,
    base_url: "http://localhost:11434"
  };
}

// Ollama model shortcuts
pub fun ollama_nomic() {
  return ollama_embedding("nomic-embed-text");
}

pub fun ollama_mxbai() {
  return ollama_embedding("mxbai-embed-large");
}

// Batch embedder with rate limiting
pub fun batch_embedder(provider) {
  return {
    provider: provider,
    batch_size: 100,
    rate_limit: nil,
    retry_config: nil,
    cache: nil
  };
}

pub fun with_rate_limit(embedder, requests_per_min) {
  embedder.rate_limit = rate_limit_info(requests_per_min, nil);
  return embedder;
}

pub fun with_retry(embedder, config) {
  embedder.retry_config = config;
  return embedder;
}

pub fun with_cache(embedder, cache) {
  embedder.cache = cache;
  return embedder;
}

// Embedding statistics
pub fun embed_stats(total_chunks, total_tokens, cache_hits, api_calls, duration_ms, estimated_cost_cents) {
  return {
    total_chunks: total_chunks,
    total_tokens: total_tokens,
    cache_hits: cache_hits,
    api_calls: api_calls,
    duration_ms: duration_ms,
    estimated_cost_cents: estimated_cost_cents
  };
}

// Embedding cache types
pub fun memory_cache(max_size) {
  return {
    kind: "Memory",
    max_size: max_size
  };
}

pub fun redis_cache(url, prefix, ttl_seconds) {
  return {
    kind: "Redis",
    url: url,
    prefix: prefix,
    ttl_seconds: ttl_seconds
  };
}

pub fun sqlite_cache(path) {
  return {
    kind: "SQLite",
    path: path
  };
}

// Similarity functions
pub fun cosine_similarity(vec1, vec2) {
  return embed_cosine_similarity(vec1, vec2);
}

pub fun euclidean_distance(vec1, vec2) {
  return embed_euclidean_distance(vec1, vec2);
}

pub fun dot_product(vec1, vec2) {
  return embed_dot_product(vec1, vec2);
}

// Vector normalization
pub fun normalize(vector) {
  return embed_normalize(vector);
}

pub fun magnitude(vector) {
  return embed_magnitude(vector);
}

// Adapter for @neam/embeddings
pub fun wrap_embedder(embedder) {
  return {
    kind: "Wrapped",
    inner: embedder,
    embed: fun(text) { return embedder.embed(text); },
    embed_batch: fun(texts) { return embedder.embed_batch(texts); },
    dimensions: fun() { return embedder.dimensions(); },
    model: fun() { return embedder.model_name(); },
    rate_limit: fun() { return nil; }
  };
}
