// Realtime provider session helpers

module std.realtime.session;

pub fun session(id, provider, state) {
  return { id: id, provider: provider, state: state };
}

pub fun connect(provider, config) {
  if (provider == nil || provider.connect == nil) {
    panic("provider missing connect");
  }
  return provider.connect(config);
}

pub fun send_audio(provider, frame) {
  if (provider == nil || provider.send_audio == nil) {
    panic("provider missing send_audio");
  }
  return provider.send_audio(frame);
}

pub fun send_text(provider, text) {
  if (provider == nil || provider.send_text == nil) {
    panic("provider missing send_text");
  }
  return provider.send_text(text);
}

pub fun send_tool_result(provider, call_id, result) {
  if (provider == nil || provider.send_tool_result == nil) {
    panic("provider missing send_tool_result");
  }
  return provider.send_tool_result(call_id, result);
}

pub fun events(provider) {
  if (provider == nil || provider.events == nil) {
    panic("provider missing events");
  }
  return provider.events();
}

pub fun interrupt(provider) {
  if (provider == nil || provider.interrupt == nil) {
    panic("provider missing interrupt");
  }
  return provider.interrupt();
}

pub fun close(provider) {
  if (provider == nil || provider.close == nil) {
    panic("provider missing close");
  }
  return provider.close();
}

pub fun config(model, system_prompt, tools, voice, modalities, turn_detection) {
  return {
    model: model,
    system_prompt: system_prompt,
    tools: tools,
    voice: voice,
    modalities: modalities,
    turn_detection: turn_detection
  };
}

pub fun modality_text() {
  return "Text";
}

pub fun modality_audio() {
  return "Audio";
}

pub fun turn_detection_config(mode, threshold, silence_ms) {
  return { mode: mode, threshold: threshold, silence_ms: silence_ms };
}

pub fun turn_detection_mode_server_vad() {
  return "ServerVad";
}

pub fun turn_detection_mode_client_vad() {
  return "ClientVad";
}

pub fun turn_detection_mode_manual() {
  return "Manual";
}
