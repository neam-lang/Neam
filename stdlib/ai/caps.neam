pub fun validate_request(request, caps) {
  if (request == nil) {
    return { ok: false, error: "request is nil" };
  }
  if (caps == nil) {
    return { ok: false, error: "caps is nil" };
  }

  if (request.input_modality != nil) {
    if (!caps.input_modalities.contains(request.input_modality)) {
      return { ok: false, error: "input modality not supported" };
    }
  }

  if (request.output_modality != nil) {
    if (!caps.output_modalities.contains(request.output_modality)) {
      return { ok: false, error: "output modality not supported" };
    }
  }

  if (request.max_context_tokens != nil && caps.max_context_tokens != nil) {
    if (request.max_context_tokens > caps.max_context_tokens) {
      return { ok: false, error: "context length exceeds caps" };
    }
  }

  if (request.max_output_tokens != nil && caps.max_output_tokens != nil) {
    if (request.max_output_tokens > caps.max_output_tokens) {
      return { ok: false, error: "output length exceeds caps" };
    }
  }

  return { ok: true, value: true };
}

pub fun supports_audio_output(caps) {
  if (caps == nil) {
    return false;
  }
  return caps.output_modalities.contains(modality_audio());
}

pub fun select_model(request, available) {
