module std.async;

pub fun resolve(value) {
  return future_resolve(value);
}

pub fun reject(error) {
  return future_reject(error);
}

pub fun all(futures) {
  return future_all(futures);
}

pub fun race(futures) {
  return future_race(futures);
}

pub fun any(futures) {
  return future_race(futures);
}

pub fun delay(ms) {
  return future_delay(ms);
}

