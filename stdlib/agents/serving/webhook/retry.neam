// Webhook retry policies

module std.agents.serving.webhook.retry;

pub fun exponential_backoff(max_attempts, base_delay_ms, max_delay_ms) {
  return {
    kind: "ExponentialBackoff",
    max_attempts: max_attempts || 3,
    base_delay_ms: base_delay_ms || 1000,
    max_delay_ms: max_delay_ms || 30000
  };
}

pub fun calculate_delay(policy, attempt) {
  if (policy == nil || policy.kind != "ExponentialBackoff") {
    return 0;
  }

  let delay = policy.base_delay_ms * pow(2, attempt - 1);
  if (delay > policy.max_delay_ms) { delay = policy.max_delay_ms; }
  return delay;
}

fun pow(base, exp) {
  let result = 1;
  let idx = 0;
  while (idx < exp) {
    result = result * base;
    idx = idx + 1;
  }
  return result;
}
