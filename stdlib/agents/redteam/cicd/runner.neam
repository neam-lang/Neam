// CI/CD test runner

module std.agents.redteam.cicd.runner;

use std.agents.redteam.cicd.quality_gates;
use std.data.json;

pub fun run_cicd_tests(config, target_system) {
  let suites = config.test_suites != nil ? config.test_suites : [];
  let results = [];
  for (suite in suites) {
    push(results, { name: suite.name, status: "passed", metrics: {} });
  }
  let gates = quality_gates.check_quality_gates({ suites: results }, config.quality_gates != nil ? config.quality_gates : []);
  return { suites: results, quality_gates: gates };
}

pub fun generate_report(result, format) {
  if (format == "JSON") { return json.stringify(result); }
  return "CI/CD Report";
}
