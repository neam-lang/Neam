// Encoding converters

module std.agents.redteam.converters.encoding;

use std.text.string as text;
use std.crypto;

pub fun base64_converter() {
  return { kind: "Base64" };
}

pub fun rot13_converter() {
  return { kind: "ROT13" };
}

pub fun url_encoder() {
  return { kind: "URLEncode" };
}

pub fun morse_converter() {
  return { kind: "Morse" };
}

pub fun convert(converter, input) {
  if (converter.kind == "Base64") { return crypto.base64_encode(input); }
  if (converter.kind == "ROT13") { return rot13(input); }
  if (converter.kind == "URLEncode") { return url_encode(input); }
  if (converter.kind == "Morse") { return to_morse(input); }
  return input;
}

pub fun revert(converter, input) {
  if (converter.kind == "Base64") { return crypto.base64_decode(input); }
  if (converter.kind == "ROT13") { return rot13(input); }
  if (converter.kind == "URLEncode") { return url_decode(input); }
  if (converter.kind == "Morse") { return from_morse(input); }
  return input;
}

fun rot13(input) {
  let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let lower = "abcdefghijklmnopqrstuvwxyz";
  let out = "";
  for (ch in text.split(input, "")) {
    let upper_index = index_of(upper, ch);
    let lower_index = index_of(lower, ch);
    if (upper_index >= 0) {
      out = out + substring(upper, (upper_index + 13) % 26, 1);
    } else if (lower_index >= 0) {
      out = out + substring(lower, (lower_index + 13) % 26, 1);
    } else {
      out = out + ch;
    }
  }
  return out;
}

fun to_morse(input) {
  let table = { a: ".-", b: "-...", c: "-.-.", d: "-..", e: ".", f: "..-.", g: "--.", h: "....", i: "..", j: ".---", k: "-.-", l: ".-..", m: "--", n: "-.", o: "---", p: ".--.", q: "--.-", r: ".-.", s: "...", t: "-", u: "..-", v: "...-", w: ".--", x: "-..-", y: "-.--", z: "--..", " ": "/" };
  let out = [];
  for (ch in text.split(text.to_lower(input), "")) {
    let code = table[ch] != nil ? table[ch] : ch;
    push(out, code);
  }
  return text.join(" ", out);
}

fun from_morse(input) {
  let table = { ".-": "a", "-...": "b", "-.-.": "c", "-..": "d", ".": "e", "..-.": "f", "--.": "g", "....": "h", "..": "i", ".---": "j", "-.-": "k", ".-..": "l", "--": "m", "-.": "n", "---": "o", ".--.": "p", "--.-": "q", ".-.": "r", "...": "s", "-": "t", "..-": "u", "...-": "v", ".--": "w", "-..-": "x", "-.--": "y", "--..": "z", "/": " " };
  let out = "";
  for (code in text.split(input, " ")) {
    out = out + (table[code] != nil ? table[code] : code);
  }
  return out;
}

fun url_encode(input) {
  return text.replace(input, " ", "%20");
}

fun url_decode(input) {
  return text.replace(input, "%20", " ");
}
