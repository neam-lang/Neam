// Prompt analytics utilities

module std.agents.prompts.observability.analytics;

pub fun get_prompt_analytics(store, prompt_id, time_range) {
  let total = 0;
  let total_latency = 0;
  let total_input_tokens = 0;
  let total_output_tokens = 0;

  for (trace in store.traces) {
    if (trace.prompt_id != prompt_id) { continue; }
    if (time_range != nil && trace.timestamp < time_range.start) { continue; }
    if (time_range != nil && trace.timestamp > time_range.end) { continue; }
    total = total + 1;
    total_latency = total_latency + trace.latency_ms;
    total_input_tokens = total_input_tokens + trace.input_tokens;
    total_output_tokens = total_output_tokens + trace.output_tokens;
  }

  let avg_latency = total > 0 ? total_latency / total : 0;
  return {
    prompt_id: prompt_id,
    total_traces: total,
    avg_latency_ms: avg_latency,
    input_tokens: total_input_tokens,
    output_tokens: total_output_tokens
  };
}
