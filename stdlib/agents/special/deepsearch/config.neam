// DeepSearch configuration

module std.agents.special.deepsearch.config;

// === Search Strategies ===

pub fun search_strategy_breadth_first() {
  return { kind: "BreadthFirst", description: "Search all sub-queries in parallel" };
}

pub fun search_strategy_depth_first() {
  return { kind: "DepthFirst", description: "Deep dive into each topic sequentially" };
}

pub fun search_strategy_adaptive() {
  return { kind: "Adaptive", description: "Dynamically adjust based on results" };
}

pub fun search_strategy_iterative() {
  return { kind: "Iterative", description: "Refine queries based on findings" };
}

// === Output Formats ===

pub fun output_format_markdown() {
  return { kind: "Markdown" };
}

pub fun output_format_html() {
  return { kind: "HTML" };
}

pub fun output_format_json() {
  return { kind: "JSON" };
}

pub fun output_format_plain() {
  return { kind: "Plain" };
}

// === Configuration ===

pub fun deepsearch_config(llm, max_iterations, max_search_depth, max_sources_per_query,
    search_strategy, output_format, include_citations, verify_claims,
    parallel_searches, timeout_ms, rag_retriever, web_search_tool, guards, budget) {
  return {
    llm: llm,
    max_iterations: max_iterations,
    max_search_depth: max_search_depth,
    max_sources_per_query: max_sources_per_query,
    search_strategy: search_strategy,
    output_format: output_format,
    include_citations: include_citations,
    verify_claims: verify_claims,
    parallel_searches: parallel_searches,
    timeout_ms: timeout_ms,
    rag_retriever: rag_retriever,
    web_search_tool: web_search_tool,
    guards: guards,
    budget: budget
  };
}

// === Error Types ===

pub fun deepsearch_error(field, message) {
  return { kind: "DeepSearchError", field: field, message: message };
}

pub fun planning_error(message, detail) {
  return { kind: "PlanningError", message: message, detail: detail };
}

pub fun search_error(message, source, detail) {
  return { kind: "SearchError", message: message, source: source, detail: detail };
}

pub fun synthesis_error(message, detail) {
  return { kind: "SynthesisError", message: message, detail: detail };
}

pub fun timeout_error(operation, timeout_ms) {
  return { kind: "TimeoutError", operation: operation, timeout_ms: timeout_ms };
}
