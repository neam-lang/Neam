// Analyst configuration

module std.agents.special.analyst.config;

// === Analysis Depth ===

pub fun analysis_depth_quick() {
  return { kind: "Quick", description: "Basic statistics only" };
}

pub fun analysis_depth_standard() {
  return { kind: "Standard", description: "Statistics + patterns" };
}

pub fun analysis_depth_deep() {
  return { kind: "Deep", description: "Full analysis with predictions" };
}

// === Sampling Strategies ===

pub fun sampling_strategy_auto() {
  return { kind: "Auto", description: "Automatically choose based on data size" };
}

pub fun sampling_strategy_random(seed) {
  return { kind: "Random", seed: seed };
}

pub fun sampling_strategy_stratified(column) {
  return { kind: "Stratified", column: column };
}

pub fun sampling_strategy_systematic(interval) {
  return { kind: "Systematic", interval: interval };
}

// === Configuration ===

pub fun analyst_config(llm, analysis_depth, enable_statistics, enable_patterns,
    enable_anomalies, enable_predictions, visualization_formats,
    max_rows_in_memory, sampling_strategy, guards, budget) {
  return {
    llm: llm,
    analysis_depth: analysis_depth,
    enable_statistics: enable_statistics,
    enable_patterns: enable_patterns,
    enable_anomalies: enable_anomalies,
    enable_predictions: enable_predictions,
    visualization_formats: visualization_formats,
    max_rows_in_memory: max_rows_in_memory,
    sampling_strategy: sampling_strategy,
    guards: guards,
    budget: budget
  };
}

// === Error Types ===

pub fun analyst_error(field, message) {
  return { kind: "AnalystError", field: field, message: message };
}

pub fun data_load_error(source, message) {
  return { kind: "DataLoadError", source: source, message: message };
}

pub fun analysis_error(operation, message) {
  return { kind: "AnalysisError", operation: operation, message: message };
}
