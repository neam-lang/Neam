// Testing helpers

fun expect_eq(left, right) {
  assert_eq(left, right);
}

fun expect_ne(left, right) {
  assert_ne(left, right);
}

fun expect_true(value) {
  assert_true(value);
}

fun expect_false(value) {
  assert_false(value);
}

fun expect_some(value) {
  assert_some(value);
}

fun expect_none(value) {
  assert_none(value);
}

fun expect_ok(value) {
  assert_ok(value);
}

fun expect_err(value) {
  assert_err(value);
}

fun expect_throws(value) {
  assert_throws(value);
}
