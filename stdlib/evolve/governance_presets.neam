// v1.5 NeamEvolve — pre-built assertion_registry presets covering common
// alignment anchors.  Reference one of these from a `belief.constraints:`
// field to satisfy E-002 + E-004 with sane defaults.

module stdlib.evolve.governance_presets

// Minimum viable alignment anchor: no secret leakage + cost cap.
assertion_registry MinimalAlignment {
    no_secret_leak: { kind: "regex",   pattern: "api_key", severity: "hard" },
    cost_cap:       { kind: "runtime", metric: "cost", op: "<=", value: 100, severity: "hard" }
}

// Stricter preset for production: also bans private keys + SSN-like patterns.
assertion_registry StrictAlignment {
    no_secret_leak: { kind: "regex", pattern: "api_key", severity: "hard" },
    no_private_key: { kind: "regex", pattern: "BEGIN.*PRIVATE KEY", severity: "hard" },
    no_ssn:         { kind: "regex", pattern: "[0-9]{3}-[0-9]{2}-[0-9]{4}", severity: "hard" },
    cost_cap:       { kind: "runtime", metric: "cost", op: "<=", value: 50, severity: "hard" }
}
