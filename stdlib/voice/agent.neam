// High-level voice agent

module std.voice.agent;

pub fun builder(name) {
  return {
    name: name,
    stt: nil,
    tts: nil,
    vad: nil,
    llm: nil,
    turn_policy: nil,
    budget: nil,
    tools: [],
    policy: nil,
    system_prompt: nil
  };
}

pub fun with_stt(builder, stt) {
  builder.stt = stt;
  return builder;
}

pub fun with_tts(builder, tts) {
  builder.tts = tts;
  return builder;
}

pub fun with_vad(builder, vad) {
  builder.vad = vad;
  return builder;
}

pub fun with_llm(builder, llm) {
  builder.llm = llm;
  return builder;
}

pub fun with_turn_policy(builder, policy) {
  builder.turn_policy = policy;
  return builder;
}

pub fun with_budget(builder, budget) {
  builder.budget = budget;
  return builder;
}

pub fun with_tool(builder, tool) {
  builder.tools.push(tool);
  return builder;
}

pub fun with_tools(builder, tools) {
  builder.tools = tools;
  return builder;
}

pub fun with_policy(builder, policy) {
  builder.policy = policy;
  return builder;
}

pub fun with_system_prompt(builder, prompt) {
  builder.system_prompt = prompt;
  return builder;
}

pub fun build(builder) {
  return {
    name: builder.name,
    stt: builder.stt,
    tts: builder.tts,
    vad: builder.vad,
    llm: builder.llm,
    turn_policy: builder.turn_policy,
    budget: builder.budget,
    tools: builder.tools,
    policy: builder.policy,
    system_prompt: builder.system_prompt
  };
}

pub fun listen_and_speak(agent, input, output) {
  return voice_session_start(agent, input, output);
}

pub fun process_turn(agent, audio_stream) {
  return voice_process_turn(agent, audio_stream);
}
