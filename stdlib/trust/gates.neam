// Promotion gates and validators

module std.trust.gates;

pub fun promote(untrusted, validator) {
  if (validator == nil) {
    panic("validator is nil");
  }
  let result = validator(untrusted);
  if (result.ok) {
    return { ok: true, value: { value: untrusted.value, provenance: result.value, trusted: true } };
  }
  return result;
}
