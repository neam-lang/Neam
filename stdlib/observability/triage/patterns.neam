// Error pattern recognition

module std.observability.triage.patterns;

pub fun create_error_analyzer(config) {
  let default_config = {
    grouping: ["error_type"],
    min_occurrences: 3,
    time_window: "24h"
  };
  return merge(default_config, config);
}

pub fun find_patterns(analyzer, traces) {
  let counts = {};
  for (trace in traces) {
    let key = build_key(trace, analyzer.grouping);
    counts[key] = (counts[key] ?? 0) + 1;
  }
  let patterns = [];
  for (key in keys(counts)) {
    if (counts[key] >= analyzer.min_occurrences) {
      push(patterns, { pattern: key, count: counts[key] });
    }
  }
  return patterns;
}

fun build_key(trace, grouping) {
  let parts = [];
  for (field in grouping) {
    push(parts, field + "=" + str(trace[field]));
  }
  return join(parts, "|");
}

fun merge(base, override) {
  let merged = json_decode(json_encode(base));
  for (key in keys(override ?? {})) {
    merged[key] = override[key];
  }
  return merged;
}
