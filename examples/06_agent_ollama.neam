//
// Example 06: Agent with Ollama (Local LLM)
// Demonstrates creating an AI agent using a local Ollama model
//
// PREREQUISITE: Install Ollama and pull a model first:
//   1. Download Ollama from https://ollama.com
//   2. Run: ollama pull llama3.2:3b
//

agent Assistant {
  provider: "ollama"
  model: "llama3.2:3b"
  temperature: 0.7
  system: "You are a helpful assistant. Answer concisely."
}

{
  emit "=== Ollama Agent Demo ===";
  emit "";

  let response = Assistant.ask("What is the capital of France? Answer in one sentence.");
  emit "Q: What is the capital of France?";
  emit "A: " + response;
  emit "";

  let response2 = Assistant.ask("Explain recursion in 2 sentences.");
  emit "Q: Explain recursion in 2 sentences.";
  emit "A: " + response2;
}
