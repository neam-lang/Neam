//
// Neam v0.6.6 — Claude Skill Integration Demo
//
// This program demonstrates the bidirectional integration between
// Neam's native skill system and Claude's tool use protocol:
//
//   Neam skill  ──────►  Claude tool (automatic JSON Schema mapping)
//   Claude tool_use  ──►  Neam skill execution (automatic dispatch)
//
// HOW IT WORKS:
//
//   1. Neam skills (declared with `skill { }`) are compiled into objects
//      with name, description, params (JSON Schema), and an impl function.
//
//   2. When an agent has `skills: [...]`, the VM automatically:
//      a) Calls build_skill_schema() to convert param types → JSON Schema
//      b) Sends skills as Claude tools[] in the Bedrock Messages API request
//      c) Claude decides which tool to call via its native protocol
//      d) VM receives tool_use blocks, maps arguments back to Neam Values
//      e) Executes the skill impl function with those arguments
//      f) Returns tool_result blocks to Claude for the next turn
//      g) Loops until Claude responds with end_turn (no more tool calls)
//
//   3. Guard chains and budgets are enforced at each tool call step.
//
// RUNNING:
//
//   # With trace logging to see the full tool call flow:
//   NEAM_LOG_LEVEL=INFO neam examples/v066_claude_skill_integration.neam
//
//   # With debug-level logging (shows JSON payloads):
//   NEAM_LOG_LEVEL=DEBUG NEAM_TRACE=1 neam examples/v066_claude_skill_integration.neam
//
// REQUIRED:
//   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
//   AWS_REGION (or defaults to us-east-1)
//


// ─────────────────────────────────────────────────────────────────────────────
// PART 1: Skills — Each becomes a Claude tool automatically
//
// Neam skill declaration       →  Claude tool JSON
// ─────────────────────────────────────────────────────────────────────────────
//
//   skill foo {                     {
//     description: "..."              "name": "foo",
//     params: {                       "description": "...",
//       x: string,                    "input_schema": {
//       y: number                       "type": "object",
//     }                                 "properties": {
//     impl(x, y) { ... }                  "x": {"type": "string"},
//   }                                     "y": {"type": "number"}
//                                       },
//                                       "required": ["x", "y"],
//                                       "additionalProperties": false
//                                     }
//                                   }
// ─────────────────────────────────────────────────────────────────────────────


// --- Skill 1: Database query simulation ---
// Claude will use this when it needs to look up structured data

skill query_database {
  description: "Query a customer database. Accepts a SQL-like filter expression and returns matching records as JSON. Supports filters on: customer_id, name, city, total_orders."
  params: {
    filter: string,
    limit: number
  }
  impl(filter, limit) {
    emit "[SKILL EXECUTED] query_database(filter=" + filter + ", limit=" + limit + ")";

    if (filter == "city = 'Tokyo'") {
      return "Results: 2 customers | #101 Tanaka Yuki, Tokyo, 47 orders | #205 Sato Hana, Tokyo, 23 orders";
    }
    if (filter == "city = 'London'") {
      return "Results: 2 customers | #302 James Smith, London, 31 orders | #415 Emma Wilson, London, 58 orders";
    }
    if (filter == "total_orders > 40") {
      return "Results: 3 customers | #101 Tanaka Yuki, Tokyo, 47 orders | #415 Emma Wilson, London, 58 orders | #512 Maria Garcia, Madrid, 62 orders";
    }
    if (filter == "customer_id = 101") {
      return "Results: 1 customer | #101 Tanaka Yuki, Tokyo, 47 orders, email: yuki@example.jp, joined: 2023-03-15";
    }
    return "No results found";
  }
}


// --- Skill 2: Analytics computation ---
// Claude will use this to perform data analysis

skill compute_analytics {
  description: "Compute analytics on a dataset. Supports operations: sum, average, count, max, min. Takes the operation name and a comma-separated list of numbers."
  params: {
    operation: string,
    values: string
  }
  impl(operation, values) {
    emit "[SKILL EXECUTED] compute_analytics(op=" + operation + ", values=" + values + ")";

    if (operation == "sum") {
      if (values == "47,23") {
        return "70";
      }
      if (values == "31,58") {
        return "89";
      }
      if (values == "47,58,62") {
        return "167";
      }
      if (values == "47,23,31,58,62") {
        return "221";
      }
    }
    if (operation == "average") {
      if (values == "47,23") {
        return "35.0";
      }
      if (values == "47,23,31,58,62") {
        return "44.2";
      }
      if (values == "47,58,62") {
        return "55.67";
      }
    }
    if (operation == "max") {
      if (values == "47,23,31,58,62") {
        return "62";
      }
      if (values == "47,58,62") {
        return "62";
      }
    }
    if (operation == "min") {
      if (values == "47,23,31,58,62") {
        return "23";
      }
    }
    if (operation == "count") {
      if (values == "47,23") {
        return "2";
      }
      if (values == "47,23,31,58,62") {
        return "5";
      }
    }
    return "Unable to compute " + operation + " for: " + values;
  }
}


// --- Skill 3: Report generation ---
// Claude will use this to format results into a report

skill generate_report {
  description: "Generate a formatted report from data. Takes a report title, the data content as a string, and a format type (markdown, plain, or csv)."
  params: {
    title: string,
    data: string,
    format: string
  }
  impl(title, data, format) {
    emit "[SKILL EXECUTED] generate_report(title=" + title + ", format=" + format + ")";

    if (format == "markdown") {
      return "# " + title + " | " + data + " | --- Generated by Neam v0.6.6 Skill System";
    }
    if (format == "csv") {
      return "title,data," + title + "," + data;
    }
    return title + " = " + data;
  }
}


// --- Skill 4: Send notification ---
// Claude will use this as a side-effect action

skill send_notification {
  description: "Send a notification message to a specified channel. Channels: email, slack, sms. Returns confirmation with a message ID."
  params: {
    channel: string,
    recipient: string,
    message: string
  }
  impl(channel, recipient, message) {
    emit "[SKILL EXECUTED] send_notification(channel=" + channel + ", to=" + recipient + ")";
    return "Notification sent via " + channel + " to " + recipient + ". Message ID: NTF-" + channel + "-2024-001. Content: " + message;
  }
}


// --- Skill 5: Time/date utility ---
// Simple utility Claude can combine with other tools

skill get_current_info {
  description: "Get current date, time, or system information. Supported queries: date, time, timezone, version."
  params: {
    query: string
  }
  impl(query) {
    emit "[SKILL EXECUTED] get_current_info(query=" + query + ")";

    if (query == "date") {
      return "2025-01-15";
    }
    if (query == "time") {
      return "14:30:00 UTC";
    }
    if (query == "timezone") {
      return "UTC+0";
    }
    if (query == "version") {
      return "Neam v0.6.6 with Claude Tool Integration";
    }
    return "Unknown query: " + query;
  }
}


// ─────────────────────────────────────────────────────────────────────────────
// PART 2: Guard — Validates tool inputs/outputs in the Claude tool call loop
// ─────────────────────────────────────────────────────────────────────────────

guard AuditGuard {
  description: "Logs all tool interactions for audit trail"

  on_tool_input(input) {
    // In production: log to audit system
    // Here we just pass through
    return input;
  }

  on_tool_output(output) {
    return output;
  }
}

guardchain SecurityChain = [AuditGuard];


// ─────────────────────────────────────────────────────────────────────────────
// PART 3: Budget — Cost control for the Claude tool call loop
// ─────────────────────────────────────────────────────────────────────────────

budget AnalyticsBudget {
  api_calls: 15
  tokens: 100000
}


// ─────────────────────────────────────────────────────────────────────────────
// PART 4: Agents — Claude with Neam skills as native tools
// ─────────────────────────────────────────────────────────────────────────────

// Full-featured agent: Claude with all 5 skills as tools
agent DataAnalyst {
  provider: "bedrock"
  model: "anthropic.claude-3-5-sonnet-20241022-v2:0"
  system: "You are a data analyst assistant. You have access to a customer database, analytics tools, report generator, notification system, and date/time utilities. Always use your tools to get real data rather than making up numbers. When asked to analyze data, follow this workflow: (1) query the database, (2) compute analytics, (3) format results. Be precise and concise."
  skills: [query_database, compute_analytics, generate_report, send_notification, get_current_info]
  guards: [SecurityChain]
  budget: AnalyticsBudget
}

// Minimal agent: Only database + analytics (demonstrates selective skill wiring)
agent SimpleAnalyst {
  provider: "bedrock"
  model: "anthropic.claude-3-5-sonnet-20241022-v2:0"
  system: "You are a simple data lookup assistant. Use your tools to query data and compute basic statistics. Be concise."
  skills: [query_database, compute_analytics]
}

// No-skills agent for comparison (uses plain chat, no tool calling)
agent PlainClaude {
  provider: "bedrock"
  model: "anthropic.claude-3-5-sonnet-20241022-v2:0"
  system: "You are a helpful assistant. Answer concisely."
}


// ─────────────────────────────────────────────────────────────────────────────
// PART 5: Integration Tests
//
// The flow for each test:
//
//   User query
//     │
//     ▼
//   Neam VM builds messages + tool definitions from agent.skills
//     │
//     ▼
//   Bedrock API call with tools[] (Claude Messages API)
//     │
//     ▼
//   Claude returns tool_use content blocks
//     │
//     ▼
//   Neam VM dispatches to skill impl() with converted arguments
//     │
//     ▼
//   Skill returns result string
//     │
//     ▼
//   Neam VM sends tool_result back to Claude
//     │
//     ▼
//   Claude processes results → more tool_use OR end_turn with text
//     │
//     ▼
//   Final text response returned to Neam program
//
// ─────────────────────────────────────────────────────────────────────────────

{
  emit "====================================================================";
  emit "  Neam v0.6.6 — Claude Skill Integration Demo";
  emit "";
  emit "  Neam skills are exposed as Claude tools via the native";
  emit "  tool use protocol. Claude decides what to call, Neam executes.";
  emit "";
  emit "  Watch for [SKILL EXECUTED] markers showing real skill dispatch.";
  emit "====================================================================";
  emit "";


  // ─── Scenario 1: Single Tool Call ─────────────────────────────────────
  // Claude should call query_database once and return the result.
  // This tests the basic Neam skill → Claude tool → skill execution flow.

  emit "=== Scenario 1: Single Tool Call (Database Query) ===";
  emit "Q: How many customers are in Tokyo?";
  emit "";
  let s1 = DataAnalyst.ask("How many customers do we have in Tokyo? Query the database with filter city = 'Tokyo'.");
  emit "";
  emit "Claude response: " + s1;
  emit "";


  // ─── Scenario 2: Multi-Tool Chain ─────────────────────────────────────
  // Claude should: (1) query_database → (2) compute_analytics → (3) report
  // This demonstrates Claude orchestrating multiple Neam skills in sequence.

  emit "=== Scenario 2: Multi-Tool Chain (Query + Analyze + Report) ===";
  emit "Q: Analyze top customers and generate a report";
  emit "";
  let s2 = DataAnalyst.ask("Find all customers with more than 40 total orders, compute the sum and average of their order counts, and generate a markdown report titled 'Top Customer Analysis'.");
  emit "";
  emit "Claude response: " + s2;
  emit "";


  // ─── Scenario 3: Claude Decides Which Tools to Use ────────────────────
  // Open-ended query — Claude must figure out the right tool combination.
  // This shows Claude's autonomous tool selection with Neam skills.

  emit "=== Scenario 3: Autonomous Tool Selection ===";
  emit "Q: Compare Tokyo and London customer bases";
  emit "";
  let s3 = DataAnalyst.ask("Compare our customer bases in Tokyo and London. How many customers in each city, and what are the total orders?");
  emit "";
  emit "Claude response: " + s3;
  emit "";


  // ─── Scenario 4: Tool + Side Effect ───────────────────────────────────
  // Claude should query data, then send a notification about it.
  // Tests that Claude can chain data retrieval with action skills.

  emit "=== Scenario 4: Data Query + Notification Action ===";
  emit "Q: Find customer 101 and notify them via email";
  emit "";
  let s4 = DataAnalyst.ask("Look up customer 101 in the database, then send them an email notification saying 'Your loyalty reward is ready!'");
  emit "";
  emit "Claude response: " + s4;
  emit "";


  // ─── Scenario 5: Utility Tool + Context ───────────────────────────────
  // Claude uses a simple utility, combined with its own knowledge.

  emit "=== Scenario 5: Utility Tool (System Info) ===";
  emit "Q: What version are we running and what's today's date?";
  emit "";
  let s5 = DataAnalyst.ask("What version of the system are we running? Also, what is today's date?");
  emit "";
  emit "Claude response: " + s5;
  emit "";


  // ─── Scenario 6: No Tool Needed ──────────────────────────────────────
  // Claude should respond directly without calling any tools.
  // Tests that the tool loop exits cleanly when Claude sends end_turn.

  emit "=== Scenario 6: No Tool Needed (Plain Claude Response) ===";
  emit "Q: What is machine learning?";
  emit "";
  let s6 = DataAnalyst.ask("In one sentence, what is machine learning?");
  emit "";
  emit "Claude response: " + s6;
  emit "";


  // ─── Scenario 7: Selective Skills (SimpleAnalyst has only 2 tools) ────
  // Tests that skill wiring is per-agent, not global.

  emit "=== Scenario 7: Selective Skill Wiring (2 tools only) ===";
  emit "Q: Find customers in London and count them";
  emit "";
  let s7 = SimpleAnalyst.ask("Query customers in London and count how many there are.");
  emit "";
  emit "Claude response: " + s7;
  emit "";


  // ─── Scenario 8: No-Skills Agent (Backward Compatibility) ────────────
  // PlainClaude has no skills → uses provider->chat() not chat_with_tools()

  emit "=== Scenario 8: No-Skills Agent (Backward Compat) ===";
  emit "Q: Say hello";
  emit "";
  let s8 = PlainClaude.ask("Say hello in one sentence.");
  emit "";
  emit "Claude response: " + s8;
  emit "";


  // ─── Scenario 9: Multi-Turn Conversation with Tool Memory ────────────
  // Tests that tool results are retained in conversation context.

  emit "=== Scenario 9: Multi-Turn with Tool Context ===";
  emit "";
  emit "Turn 1: Query Tokyo customers";
  let t1 = DataAnalyst.ask("Query the database for customers in Tokyo.");
  emit "  Claude: " + t1;
  emit "";

  emit "Turn 2: Now analyze those results";
  let t2 = DataAnalyst.ask("Based on the Tokyo customers you just found, what is the average number of orders?");
  emit "  Claude: " + t2;
  emit "";

  emit "Turn 3: Generate a report about this";
  let t3 = DataAnalyst.ask("Generate a markdown report titled 'Tokyo Customer Summary' with the data from our previous analysis.");
  emit "  Claude: " + t3;
  emit "";


  // ─── Scenario 10: Full Workflow ──────────────────────────────────────
  // Complex end-to-end: query → analyze → report → notify
  // This is the full Claude tool orchestration with 4+ skill calls.

  emit "=== Scenario 10: Full Workflow (Query + Analyze + Report + Notify) ===";
  emit "Q: Full customer analysis with notification";
  emit "";
  let s10 = DataAnalyst.ask("Do a complete analysis: (1) find all customers with more than 40 orders, (2) compute the max order count, (3) generate a plain text report titled 'VIP Customer Alert', and (4) send a slack notification to #analytics channel with a summary.");
  emit "";
  emit "Claude response: " + s10;
  emit "";


  emit "====================================================================";
  emit "  Demo complete!";
  emit "";
  emit "  Each [SKILL EXECUTED] line above shows a Neam skill being";
  emit "  invoked by Claude's native tool use protocol.";
  emit "";
  emit "  For detailed protocol logs, re-run with:";
  emit "    NEAM_LOG_LEVEL=DEBUG NEAM_TRACE=1 neam <this_file>";
  emit "====================================================================";
}
