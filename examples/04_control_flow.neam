//
// Example 04: Control Flow
// Demonstrates if/else and while loops
//

fun fizzbuzz(n) {
  let i = 1;
  while (i <= n) {
    if (i % 15 == 0) {
      emit str(i) + ": FizzBuzz";
    } else if (i % 3 == 0) {
      emit str(i) + ": Fizz";
    } else if (i % 5 == 0) {
      emit str(i) + ": Buzz";
    } else {
      emit str(i);
    }
    i = i + 1;
  }
}

{
  emit "=== FizzBuzz (1-20) ===";
  fizzbuzz(20);
}
