// v0.8 Phase 0: Claw Agent + Forge Agent parser/compiler test
// Tests: lexer tokens, AST nodes, field parsing, compilation

// === Skill stubs ===
skill greet {
  description: "Greets a user"
  params: { name: string }
  impl(name) { return "Hello"; }
}

skill code_gen {
  description: "Generates code"
  params: { spec: string }
  impl(spec) { return "// code"; }
}

// === Guard chain stub ===
guard input_guard {
  description: "Validates input"
  on_observation(text) { return text; }
}

guardchain safety_chain = [input_guard];

// === Verify function (used by forge agents) ===
fun check_result(ctx) {
  return true;
}

// === 1. Claw agent — full field declaration ===
claw agent support_bot {
  provider: "openai"
  model: "gpt-4o"
  endpoint: "https://api.openai.com/v1"
  api_key_env: "OPENAI_API_KEY"
  temperature: 0.7
  system: "You are a helpful support agent."
  skills: [greet]
  guards: [safety_chain]
  channels: [greet]
  session: {
    idle_reset_minutes: 30
    daily_reset_hour: 4
    max_history_turns: 50
    compaction: "auto"
  }
  lanes: {
    default: {
      concurrency: 3
      priority: "normal"
    }
    urgent: {
      concurrency: 1
      priority: "high"
    }
  }
  semantic_memory: {
    backend: "sqlite"
    search: "hybrid"
    flush_on_compact: true
  }
  workspace: "/tmp/support"
}

// === 2. Claw agent — minimal (only required fields) ===
claw agent minimal_claw {
  provider: "openai"
  model: "gpt-4o"
  channels: [greet]
}

// === 3. Forge agent — full field declaration ===
forge agent code_builder {
  provider: "openai"
  model: "gpt-4o"
  endpoint: "https://api.openai.com/v1"
  api_key_env: "OPENAI_API_KEY"
  temperature: 0.2
  system: "You are a code generation agent."
  skills: [code_gen]
  guards: [safety_chain]
  loop: {
    max_iterations: 10
    max_cost: 5.0
    max_tokens: 100000
    prompt_file: "prompt.md"
    plan_file: "plan.md"
    progress_file: "progress.md"
    learnings_file: "learnings.md"
  }
  verify: check_result
  checkpoint: "git"
  workspace: "/tmp/forge"
}

// === 4. Forge agent — minimal (only required fields) ===
forge agent minimal_forge {
  provider: "openai"
  model: "gpt-4o"
  verify: check_result
}

// === 5. Plain agent (backward compat) ===
agent legacy_bot {
  provider: "openai"
  model: "gpt-4o"
  skills: [greet]
}

// If we reach here, all three agent types parsed and compiled successfully
emit "v0.8 Phase 0: All agent types parsed and compiled successfully";
