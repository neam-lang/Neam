// Test voice configuration validation

agent VoiceAgent {
    model "gpt-4"
    instructions "You are a voice assistant."
}

// Voice pipeline with STT and TTS
voice_pipeline BasicVoice {
    stt "whisper"
    tts "openai"
    agent VoiceAgent
}

// Realtime voice
realtime_voice LiveChat {
    provider "openai"
    model "gpt-4o-realtime"
    voice "alloy"
}

// Alternative providers
realtime_voice GeminiLive {
    provider "gemini"
    model "gemini-2.0-flash"
    voice "default"
}

// Local voice pipeline
voice_pipeline LocalVoice {
    stt "whisper"
    tts "piper"
    agent VoiceAgent
}
