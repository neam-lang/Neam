// ============================================
// Local Streaming Pipeline Tests
// Tests chunk-based STT + streaming LLM + incremental TTS
// ============================================

agent local_llm {
  provider: "ollama"
  model: "llama3"
  system: "You are a helpful assistant. Keep responses concise."
}

realtime_voice local_stream {
  agent: local_llm
  rt_provider: "local"
  rt_model: "llama3"
  rt_voice: "af_heart"
  rt_vad: "server"
  vad_threshold: "0.5"
  silence_duration_ms: "500"
  input_format: "pcm16"
  output_format: "pcm16"
  sample_rate: "16000"
  rt_speed: "1.0"
  rt_stt_endpoint: "http://localhost:8080"
  rt_tts_endpoint: "http://localhost:8880"
  rt_llm_endpoint: "http://localhost:11434"
}

// Variant with different model
realtime_voice local_stream_mistral {
  agent: local_llm
  rt_provider: "local"
  rt_model: "mistral"
  rt_voice: "af_bella"
  rt_vad: "server"
  vad_threshold: "0.5"
  silence_duration_ms: "500"
  input_format: "pcm16"
  output_format: "pcm16"
  sample_rate: "16000"
  rt_speed: "1.0"
  rt_stt_endpoint: "http://localhost:8080"
  rt_tts_endpoint: "http://localhost:8880"
  rt_llm_endpoint: "http://localhost:11434"
}

// --- Main test execution ---
{
  emit "=== Local Streaming Pipeline Tests ===";
  emit "";

  // Test 1: Local streaming definition compiles
  emit "Test 1: Local streaming definition";
  emit "  rt_provider=local, rt_model=llama3, rt_voice=af_heart";
  emit "  rt_stt_endpoint=http://localhost:8080 (whisper.cpp)";
  emit "  rt_tts_endpoint=http://localhost:8880 (Kokoro)";
  emit "  rt_llm_endpoint=http://localhost:11434 (Ollama)";
  emit "  Result: PASSED (definition compiled)";
  emit "";

  // Test 2: Local streaming with different model
  emit "Test 2: Local streaming with mistral model";
