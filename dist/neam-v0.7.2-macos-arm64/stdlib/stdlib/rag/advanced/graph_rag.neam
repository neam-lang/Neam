// Knowledge graph RAG

module std.rag.advanced.graph_rag;

use std.rag.document;

pub fun node_entity(id, name, entity_type, properties) {
  return {
    kind: "Entity",
    id: id,
    name: name,
    entity_type: entity_type,
    properties: properties
  };
}

pub fun node_document(id, content, metadata) {
  return {
    kind: "Document",
    id: id,
    content: content,
    metadata: metadata
  };
}

pub fun node_community(id, summary, members) {
  return {
    kind: "Community",
    id: id,
    summary: summary,
    members: members
  };
}

pub fun edge_mentions(source_id, target_id, context) {
  return {
    kind: "Mentions",
    source: source_id,
    target: target_id,
    context: context
  };
}

pub fun edge_related_to(source_id, target_id, relation_type, confidence) {
  return {
    kind: "RelatedTo",
    source: source_id,
    target: target_id,
    relation_type: relation_type,
    confidence: confidence
  };
}

pub fun edge_part_of(source_id, target_id) {
  return {
    kind: "PartOf",
    source: source_id,
    target: target_id
  };
}

pub fun knowledge_graph() {
  return {
    nodes: {},
    edges: [],
    communities: [],
    entity_index: {},
    document_index: []
  };
}

pub fun add_node(graph, node) {
  graph.nodes[node.id] = node;

  if (node.kind == "Entity") {
    if (graph.entity_index[node.entity_type] == nil) {
      graph.entity_index[node.entity_type] = [];
    }
    push(graph.entity_index[node.entity_type], node.id);
  } else if (node.kind == "Document") {
    push(graph.document_index, node.id);
  }

  return graph;
}

pub fun add_edge(graph, edge) {
  push(graph.edges, edge);
  return graph;
}

pub fun add_community(graph, community) {
  push(graph.communities, community);
  graph.nodes[community.id] = community;
  return graph;
}

pub fun graph_rag_builder(graph) {
  return {
    graph: graph,
    llm: nil,
    embedder: nil,
    entity_extractor: nil,
    community_detector: nil,
    search_depth: 2,
    include_communities: true,
    include_relations: true
  };
}

pub fun with_graph_llm(builder, llm) {
  builder.llm = llm;
  return builder;
}

pub fun with_graph_embedder(builder, embedder) {
  builder.embedder = embedder;
  return builder;
}

pub fun with_entity_extractor(builder, extractor) {
  builder.entity_extractor = extractor;
  return builder;
}

pub fun with_community_detector(builder, detector) {
  builder.community_detector = detector;
  return builder;
}

pub fun with_search_depth(builder, depth) {
  builder.search_depth = depth;
  return builder;
}

pub fun with_include_communities(builder, include) {
  builder.include_communities = include;
  return builder;
}

pub fun with_include_relations(builder, include) {
  builder.include_relations = include;
  return builder;
}

pub fun build_graph_rag(builder) {
  return {
    ok: true,
    value: {
      kind: "GraphRAG",
      graph: builder.graph,
      llm: builder.llm,
      embedder: builder.embedder,
      entity_extractor: builder.entity_extractor,
      community_detector: builder.community_detector,
      search_depth: builder.search_depth,
      include_communities: builder.include_communities,
      include_relations: builder.include_relations
    }
  };
}

pub fun graph_retrieve(graph_rag, query) {
  let query_entities = graph_rag.entity_extractor(query);

  let matched_entities = [];
  for (entity in query_entities) {
    let matches = find_entities(graph_rag.graph, entity);
    matched_entities = concat(matched_entities, matches);
  }

  let context_nodes = [];
  let visited = {};

  for (entity_id in matched_entities) {
    traverse_graph(
      graph_rag.graph,
      entity_id,
      graph_rag.search_depth,
      visited,
      context_nodes
    );
  }

  let community_context = [];
  if (graph_rag.include_communities) {
    community_context = get_relevant_communities(
      graph_rag.graph,
      matched_entities
    );
  }

  let documents = [];
  for (node in context_nodes) {
    if (node.kind == "Document") {
      push(documents, document.rag_document(node.id, node.content, node.metadata));
    } else if (node.kind == "Entity") {
      let content = "Entity: " + node.name + " (" + node.entity_type + ")";
      if (node.properties != nil) {
        content = content + "\nProperties: " + json_stringify(node.properties);
      }
      push(documents, document.rag_document(node.id, content, { entity_type: node.entity_type }));
    }
  }

  for (community in community_context) {
    push(documents, document.rag_document(
      community.id,
      "Community Summary: " + community.summary,
      { type: "community", members: len(community.members) }
    ));
  }

  return {
    documents: documents,
    matched_entities: matched_entities,
    traversed_nodes: len(context_nodes),
    communities_used: len(community_context)
  };
}

fun find_entities(graph, entity_name) {
  let matches = [];
  let normalized = lowercase(entity_name);

  for (id, node in graph.nodes) {
    if (node.kind == "Entity") {
      if (lowercase(node.name) == normalized ||
          contains(lowercase(node.name), normalized)) {
        push(matches, id);
      }
    }
  }

  return matches;
}

fun traverse_graph(graph, start_id, depth, visited, results) {
  if (depth <= 0 || visited[start_id]) {
    return;
  }

  visited[start_id] = true;
  let node = graph.nodes[start_id];

  if (node != nil) {
    push(results, node);

    for (edge in graph.edges) {
      if (edge.source == start_id && !visited[edge.target]) {
        traverse_graph(graph, edge.target, depth - 1, visited, results);
      } else if (edge.target == start_id && !visited[edge.source]) {
        traverse_graph(graph, edge.source, depth - 1, visited, results);
      }
    }
  }
}

fun get_relevant_communities(graph, entity_ids) {
  let relevant = [];

  for (community in graph.communities) {
    for (entity_id in entity_ids) {
      if (contains(community.members, entity_id)) {
        push(relevant, community);
        break;
      }
    }
  }

  return relevant;
}
