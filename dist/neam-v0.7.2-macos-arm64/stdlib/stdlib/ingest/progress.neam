// Pipeline progress tracking

module std.ingest.progress;

// Progress events
pub fun progress_started(pipeline_name, total_sources) {
  return {
    kind: "Started",
    pipeline_name: pipeline_name,
    total_sources: total_sources
  };
}

pub fun progress_source_started(source_name, total_documents) {
  return {
    kind: "SourceStarted",
    source_name: source_name,
    total_documents: total_documents
  };
}

pub fun progress_document(source_name, document_id, stage, progress_percent) {
  return {
    kind: "DocumentProgress",
    source_name: source_name,
    document_id: document_id,
    stage: stage,
    progress_percent: progress_percent
  };
}

pub fun progress_source_completed(source_name, documents_processed, duration_ms) {
  return {
    kind: "SourceCompleted",
    source_name: source_name,
    documents_processed: documents_processed,
    duration_ms: duration_ms
  };
}

pub fun progress_completed(result) {
  return {
    kind: "Completed",
    result: result
  };
}

pub fun progress_error(source_name, document_id, error) {
  return {
    kind: "Error",
    source_name: source_name,
    document_id: document_id,
    error: error
  };
}

// Progress handler
pub fun console_progress(show_documents, show_chunks) {
  return {
    kind: "Console",
    show_documents: show_documents,
    show_chunks: show_chunks
  };
}

pub fun callback_progress(callback) {
  return {
    kind: "Callback",
    callback: callback
  };
}
