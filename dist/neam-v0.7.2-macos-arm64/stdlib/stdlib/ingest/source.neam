// Data source configurations for ingestion

module std.ingest.source;

pub fun source_metadata(source_type, supports_incremental, supports_streaming) {
  return {
    source_type: source_type,
    supports_incremental: supports_incremental,
    supports_streaming: supports_streaming
  };
}

pub fun file_source(path) {
  return {
    kind: "File",
    paths: [path],
    recursive: false,
    include_patterns: [],
    exclude_patterns: [],
    follow_symlinks: false
  };
}

pub fun file_source_paths(paths) {
  return {
    kind: "File",
    paths: paths,
    recursive: false,
    include_patterns: [],
    exclude_patterns: [],
    follow_symlinks: false
  };
}

pub fun with_recursive(source, recursive) {
  source.recursive = recursive;
  return source;
}

pub fun with_include(source, pattern) {
  push(source.include_patterns, pattern);
  return source;
}

pub fun with_exclude(source, pattern) {
  push(source.exclude_patterns, pattern);
  return source;
}

pub fun with_symlinks(source, follow) {
  source.follow_symlinks = follow;
  return source;
}

pub fun s3_credentials_default() { return { kind: "Default" }; }

pub fun s3_credentials_static(access_key, secret_key) {
  return { kind: "Static", access_key: access_key, secret_key: secret_key };
}

pub fun s3_credentials_assume_role(role_arn) {
  return { kind: "AssumeRole", role_arn: role_arn };
}

pub fun s3_credentials_profile(name) {
  return { kind: "Profile", name: name };
}

pub fun s3_source(bucket) {
  return {
    kind: "S3",
    bucket: bucket,
    prefix: nil,
    region: nil,
    endpoint: nil,
    credentials: s3_credentials_default(),
    include_patterns: [],
    exclude_patterns: []
  };
}

pub fun with_prefix(source, prefix) {
  source.prefix = prefix;
  return source;
}

pub fun with_region(source, region) {
  source.region = region;
  return source;
}

pub fun with_endpoint(source, endpoint) {
  source.endpoint = endpoint;
  return source;
}

pub fun with_credentials(source, credentials) {
  source.credentials = credentials;
  return source;
}

pub fun gcs_credentials_default() { return { kind: "Default" }; }

pub fun gcs_credentials_service_account(path) {
  return { kind: "ServiceAccount", path: path };
}

pub fun gcs_credentials_json(json) {
  return { kind: "Json", json: json };
}

pub fun gcs_source(bucket) {
  return {
    kind: "GCS",
    bucket: bucket,
    prefix: nil,
    credentials: gcs_credentials_default()
  };
}

pub fun azure_blob_source(container) {
  return {
    kind: "AzureBlob",
    container: container,
    prefix: nil,
    connection_string: nil,
    account_name: nil,
    account_key: nil
  };
}

pub fun with_connection_string(source, conn_str) {
  source.connection_string = conn_str;
  return source;
}

pub fun with_account(source, name, key) {
  source.account_name = name;
  source.account_key = key;
  return source;
}

pub fun http_auth_basic(username, password) {
  return { kind: "Basic", username: username, password: password };
}

pub fun http_auth_bearer(token) {
  return { kind: "Bearer", token: token };
}

pub fun http_auth_api_key(header, key) {
  return { kind: "ApiKey", header: header, key: key };
}

pub fun http_source(url) {
  return {
    kind: "HTTP",
    urls: [url],
    headers: {},
    auth: nil,
    timeout_ms: 30000,
    follow_redirects: true,
    max_redirects: 5
  };
}

pub fun http_source_urls(urls) {
  return {
    kind: "HTTP",
    urls: urls,
    headers: {},
    auth: nil,
    timeout_ms: 30000,
    follow_redirects: true,
    max_redirects: 5
  };
}

pub fun with_header(source, name, value) {
  source.headers[name] = value;
  return source;
}

pub fun with_auth(source, auth) {
  source.auth = auth;
  return source;
}

pub fun with_timeout(source, ms) {
  source.timeout_ms = ms;
  return source;
}

pub fun with_redirects(source, follow, max) {
  source.follow_redirects = follow;
  source.max_redirects = max;
  return source;
}

pub fun db_postgres(url) { return { kind: "Postgres", url: url }; }
pub fun db_mysql(url) { return { kind: "MySQL", url: url }; }
pub fun db_sqlite(path) { return { kind: "SQLite", path: path }; }

pub fun db_mongodb(url, database, collection) {
  return { kind: "MongoDB", url: url, database: database, collection: collection };
}

pub fun database_source(connection) {
  return {
    kind: "Database",
    connection: connection,
    query: nil,
    content_columns: [],
    metadata_columns: [],
    id_column: "id",
    batch_size: 1000
  };
}

pub fun with_query(source, query) {
  source.query = query;
  return source;
}

pub fun with_content_columns(source, columns) {
  source.content_columns = columns;
  return source;
}

pub fun with_metadata_columns(source, columns) {
  source.metadata_columns = columns;
  return source;
}

pub fun with_id_column(source, column) {
  source.id_column = column;
  return source;
}

pub fun with_batch_size(source, size) {
  source.batch_size = size;
  return source;
}

pub fun kafka_source(brokers, topic, consumer_group) {
  return {
    kind: "Kafka",
    brokers: brokers,
    topic: topic,
    consumer_group: consumer_group,
    auto_commit: true
  };
}

pub fun with_auto_commit(source, auto_commit) {
  source.auto_commit = auto_commit;
  return source;
}

pub fun redis_stream_source(url, stream_key, consumer_group) {
  return {
    kind: "RedisStream",
    url: url,
    stream_key: stream_key,
    consumer_group: consumer_group
  };
}

pub fun webhook_source(listen_addr, path) {
  return {
    kind: "Webhook",
    listen_addr: listen_addr,
    path: path,
    auth: nil
  };
}
