// DeepSearch agent implementation

module std.agents.special.deepsearch.agent;

use std.agents.special.base;
use std.agents.special.deepsearch.planner;
use std.agents.special.deepsearch.searcher;
use std.agents.special.deepsearch.synthesizer;
use std.agents.special.deepsearch.config;
use std.rag.retriever;
use std.rag.chain;

// === Type Constructors ===

pub fun deepsearch_agent(config) {
  return {
    kind: "DeepSearchAgent",
    config: config,
    planner: planner.create(config.llm),
    searcher: searcher.create(config),
    synthesizer: synthesizer.create(config.llm),
    state: agent_state_idle(),
    session: nil
  };
}

pub fun agent_state_idle() { return { kind: "Idle" }; }
pub fun agent_state_planning() { return { kind: "Planning" }; }
pub fun agent_state_searching() { return { kind: "Searching", progress: 0 }; }
pub fun agent_state_synthesizing() { return { kind: "Synthesizing" }; }
pub fun agent_state_reflecting() { return { kind: "Reflecting" }; }
pub fun agent_state_completed() { return { kind: "Completed" }; }
pub fun agent_state_error(message) { return { kind: "Error", message: message }; }

// === Builder Pattern ===

pub fun deepsearch_builder(llm) {
  return {
    llm: llm,
    max_iterations: 10,
    max_search_depth: 3,
    max_sources_per_query: 10,
    search_strategy: config.search_strategy_adaptive(),
    output_format: config.output_format_markdown(),
    include_citations: true,
    verify_claims: true,
    parallel_searches: 5,
    timeout_ms: 300000,
    rag_retriever: nil,
    web_search_tool: nil,
    guards: [],
    budget: nil
  };
}

pub fun with_max_iterations(builder, max) {
  builder.max_iterations = max;
  return builder;
}

pub fun with_search_depth(builder, depth) {
  builder.max_search_depth = depth;
  return builder;
}

pub fun with_search_strategy(builder, strategy) {
  builder.search_strategy = strategy;
  return builder;
}

pub fun with_output_format(builder, format) {
  builder.output_format = format;
  return builder;
}

pub fun with_citations(builder, include) {
  builder.include_citations = include;
  return builder;
}

pub fun with_verification(builder, verify) {
  builder.verify_claims = verify;
  return builder;
}

pub fun with_parallel_searches(builder, count) {
  builder.parallel_searches = count;
  return builder;
}

pub fun with_timeout(builder, timeout_ms) {
  builder.timeout_ms = timeout_ms;
  return builder;
}

pub fun with_rag_retriever(builder, retriever_instance) {
  builder.rag_retriever = retriever_instance;
  return builder;
}

pub fun with_web_search(builder, search_tool) {
  builder.web_search_tool = search_tool;
  return builder;
}

pub fun with_guard(builder, guard) {
  push(builder.guards, guard);
  return builder;
}

pub fun with_budget(builder, budget) {
  builder.budget = budget;
  return builder;
}

pub fun build_deepsearch_agent(builder) {
  if (builder.llm == nil) {
    return { ok: false, error: config.deepsearch_error("llm", "LLM is required") };
  }
  if (builder.web_search_tool == nil && builder.rag_retriever == nil) {
    return { ok: false, error: config.deepsearch_error("search", "At least one search source required") };
  }

  let agent_config = config.deepsearch_config(
    builder.llm,
    builder.max_iterations,
    builder.max_search_depth,
    builder.max_sources_per_query,
    builder.search_strategy,
    builder.output_format,
    builder.include_citations,
    builder.verify_claims,
    builder.parallel_searches,
    builder.timeout_ms,
    builder.rag_retriever,
    builder.web_search_tool,
    builder.guards,
    builder.budget
  );

  return { ok: true, value: deepsearch_agent(agent_config) };
}

// === Core Operations ===

pub fun research(agent, query) {
  return research_with_options(agent, query, research_options_default());
}

pub fun research_with_options(agent, query, options) {
  let session = base.create_session(agent, query, options);
  agent.session = session;
  agent.state = agent_state_planning();

  let plan_result = planner.plan(agent.planner, query, options);
  if (!plan_result.ok) {
    agent.state = agent_state_error(plan_result.error.message);
    return { ok: false, error: plan_result.error };
  }
  let plan = plan_result.value;
  session.plan = plan;

  agent.state = agent_state_searching();
  let search_results = [];
  let total_queries = len(plan.sub_queries);
  if (total_queries == 0) { total_queries = 1; }

  for (sub_query in plan.sub_queries) {
    let results = searcher.search(agent.searcher, sub_query, options);
    search_results = concat(search_results, results);
    session.progress = len(search_results) / total_queries;

    base.emit_progress(agent, session);

    if (session.cancelled) {
      agent.state = agent_state_idle();
      return { ok: false, error: config.deepsearch_error("cancelled", "Session cancelled") };
    }
  }
  session.search_results = search_results;

  agent.state = agent_state_synthesizing();
  let synthesis = synthesizer.synthesize(agent.synthesizer, query, search_results, plan);
  session.synthesis = synthesis;

  if (agent.config.verify_claims) {
    agent.state = agent_state_reflecting();
    let verified = verify_and_reflect(agent, synthesis, search_results);
    session.final_report = verified;
  } else {
    session.final_report = synthesis;
  }

  agent.state = agent_state_completed();
  return { ok: true, value: format_report(session.final_report, agent.config.output_format, agent.config.include_citations) };
}

pub fun research_stream(agent, query, on_progress) {
  let options = research_options_default();
  options.on_progress = on_progress;
  return research_with_options(agent, query, options);
}

pub fun cancel(agent) {
  if (agent.session != nil) {
    agent.session.cancelled = true;
  }
  agent.state = agent_state_idle();
  return agent;
}

pub fun get_state(agent) {
  return agent.state;
}

pub fun get_session(agent) {
  return agent.session;
}

// === Research Options ===

pub fun research_options_default() {
  return {
    focus_areas: [],
    exclude_domains: [],
    preferred_sources: [],
    time_range: nil,
    language: "en",
    max_report_length: nil,
    on_progress: nil
  };
}

pub fun with_focus_areas(options, areas) {
  options.focus_areas = areas;
  return options;
}

pub fun with_excluded_domains(options, domains) {
  options.exclude_domains = domains;
  return options;
}

pub fun with_preferred_sources(options, sources) {
  options.preferred_sources = sources;
  return options;
}

pub fun with_time_range(options, start, end) {
  options.time_range = { start: start, end: end };
  return options;
}

pub fun with_language(options, lang) {
  options.language = lang;
  return options;
}

// === Helpers ===

fun verify_and_reflect(agent, report, search_results) {
  let verification = {
    verified: true,
    issues: [],
    sources_checked: len(search_results),
    checked_at: now()
  };
  report.verification = verification;
  return report;
}

fun format_report(report, output_format, include_citations) {
  if (!include_citations) {
    report.citations = [];
  }

  if (output_format.kind == "JSON") {
    return json_stringify(report);
  }
  if (output_format.kind == "HTML") {
    return render_report_html(report);
  }
  if (output_format.kind == "Plain") {
    return render_report_plain(report);
  }
  return render_report_markdown(report);
}

fun render_report_markdown(report) {
  let lines = [];
  push(lines, "# Research Report");
  push(lines, "\n## Query\n" + report.query);
  push(lines, "\n## Summary\n" + report.summary);

  if (len(report.sections) > 0) {
    push(lines, "\n## Findings");
    for (section in report.sections) {
      push(lines, "\n### " + section.title + "\n" + section.content);
    }
  }

  if (len(report.citations) > 0) {
    push(lines, "\n## Citations");
    for (c in report.citations) {
      push(lines, "[" + str(c.index) + "] " + c.title + " (" + c.source_type + ")");
    }
  }

  return join(lines, "\n");
}

fun render_report_html(report) {
  let html = "<h1>Research Report</h1>";
  html = html + "<h2>Query</h2><p>" + report.query + "</p>";
  html = html + "<h2>Summary</h2><p>" + report.summary + "</p>";

  if (len(report.sections) > 0) {
    html = html + "<h2>Findings</h2>";
    for (section in report.sections) {
      html = html + "<h3>" + section.title + "</h3><p>" + section.content + "</p>";
    }
  }

  if (len(report.citations) > 0) {
    html = html + "<h2>Citations</h2><ul>";
    for (c in report.citations) {
      html = html + "<li>[" + str(c.index) + "] " + c.title + "</li>";
    }
    html = html + "</ul>";
  }

  return html;
}

fun render_report_plain(report) {
  let lines = [];
  push(lines, "Research Report");
  push(lines, "Query: " + report.query);
  push(lines, "Summary: " + report.summary);

  if (len(report.sections) > 0) {
    for (section in report.sections) {
      push(lines, section.title + ": " + section.content);
    }
  }

  return join(lines, "\n");
}
