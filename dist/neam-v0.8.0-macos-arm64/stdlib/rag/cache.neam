// Semantic caching for RAG

module std.rag.cache;

use std.ingest.embed;
use std.rag.chain;

pub fun cache_memory(max_size) {
  return {
    kind: "Memory",
    max_size: max_size,
    eviction: "lru"
  };
}

pub fun cache_redis(url, prefix, ttl_seconds) {
  return {
    kind: "Redis",
    url: url,
    prefix: prefix,
    ttl_seconds: ttl_seconds
  };
}

pub fun cache_sqlite(path) {
  return {
    kind: "SQLite",
    path: path
  };
}

pub fun semantic_cache_builder(cache_type) {
  return {
    cache_type: cache_type,
    similarity_threshold: 0.95,
    embedder: nil,
    max_entries: 10000
  };
}

pub fun with_similarity_threshold(builder, threshold) {
  builder.similarity_threshold = threshold;
  return builder;
}

pub fun with_cache_embedder(builder, embedder) {
  builder.embedder = embedder;
  return builder;
}

pub fun with_max_entries(builder, max) {
  builder.max_entries = max;
  return builder;
}

pub fun build_semantic_cache(builder) {
  return {
    ok: true,
    value: {
      kind: "SemanticCache",
      cache_type: builder.cache_type,
      similarity_threshold: builder.similarity_threshold,
      embedder: builder.embedder,
      max_entries: builder.max_entries,
      entries: [],
      embeddings: []
    }
  };
}

pub fun cache_get(cache, query) {
  let query_embedding = cache.embedder.embed(query);

  for (i, entry_embedding in enumerate(cache.embeddings)) {
    let similarity = embed.cosine_similarity(query_embedding, entry_embedding);
    if (similarity >= cache.similarity_threshold) {
      let entry = cache.entries[i];
      entry.hits = entry.hits + 1;
      entry.last_accessed = now();
      return { hit: true, value: entry.response };
    }
  }

  return { hit: false, value: nil };
}

pub fun cache_set(cache, query, response) {
  let query_embedding = cache.embedder.embed(query);

  if (len(cache.entries) >= cache.max_entries) {
    evict_entry(cache);
  }

  push(cache.entries, {
    query: query,
    response: response,
    created_at: now(),
    last_accessed: now(),
    hits: 0
  });
  push(cache.embeddings, query_embedding);

  return cache;
}

fun evict_entry(cache) {
  let eviction = cache.cache_type.eviction || "lru";
  if (eviction == "lru" && len(cache.entries) > 0) {
    let oldest_idx = 0;
    let oldest_time = cache.entries[0].last_accessed;

    for (i, entry in enumerate(cache.entries)) {
      if (entry.last_accessed < oldest_time) {
        oldest_idx = i;
        oldest_time = entry.last_accessed;
      }
    }

    remove_at(cache.entries, oldest_idx);
    remove_at(cache.embeddings, oldest_idx);
  }
}

pub fun cached_rag_chain(chain_instance, cache) {
  return {
    kind: "CachedRAGChain",
    chain: chain_instance,
    cache: cache
  };
}

pub fun run_cached_chain(cached_chain, question) {
  let cache_result = cache_get(cached_chain.cache, question);

  if (cache_result.hit) {
    return {
      answer: cache_result.value.answer,
      sources: cache_result.value.sources,
      from_cache: true
    };
  }

  let result = chain.run_chain(cached_chain.chain, question);

  cache_set(cached_chain.cache, question, result);

  result.from_cache = false;
  return result;
}
