// Conversational memory integration

module std.rag.memory;

use std.rag.chain;

pub fun conversation_memory(max_turns) {
  return {
    kind: "ConversationMemory",
    max_turns: max_turns,
    history: []
  };
}

pub fun add_turn(memory, question, answer, sources) {
  push(memory.history, {
    question: question,
    answer: answer,
    sources: sources,
    timestamp: now()
  });

  if (len(memory.history) > memory.max_turns) {
    memory.history = skip(memory.history, 1);
  }

  return memory;
}

pub fun get_history_context(memory) {
  let parts = [];
  for (turn in memory.history) {
    push(parts, "Q: " + turn.question);
    push(parts, "A: " + turn.answer);
  }
  return join(parts, "\n");
}

pub fun clear_memory(memory) {
  memory.history = [];
  return memory;
}

pub fun memory_rag_chain_builder(base_chain) {
  return {
    chain: base_chain,
    memory: nil,
    include_history_in_context: true,
    include_history_in_query: false,
    history_weight: 0.3
  };
}

pub fun with_memory(builder, memory) {
  builder.memory = memory;
  return builder;
}

pub fun with_history_in_context(builder, include) {
  builder.include_history_in_context = include;
  return builder;
}

pub fun with_history_in_query(builder, include) {
  builder.include_history_in_query = include;
  return builder;
}

pub fun build_memory_rag_chain(builder) {
  return {
    ok: true,
    value: {
      kind: "MemoryRAGChain",
      chain: builder.chain,
      memory: builder.memory,
      include_history_in_context: builder.include_history_in_context,
      include_history_in_query: builder.include_history_in_query
    }
  };
}

pub fun run_memory_chain(memory_chain, question) {
  let enhanced_question = question;

  if (memory_chain.include_history_in_query && len(memory_chain.memory.history) > 0) {
    let history = get_history_context(memory_chain.memory);
    enhanced_question = "Previous conversation:\n" + history + "\n\nCurrent question: " + question;
  }

  let result = chain.run_chain(memory_chain.chain, enhanced_question);

  add_turn(memory_chain.memory, question, result.answer, result.sources);

  return result;
}
