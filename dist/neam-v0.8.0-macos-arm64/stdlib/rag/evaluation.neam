// RAGAS-like evaluation metrics

module std.rag.evaluation;

use std.ingest.embed;

pub fun metric_faithfulness() {
  return { kind: "Faithfulness" };
}

pub fun metric_answer_relevancy() {
  return { kind: "AnswerRelevancy" };
}

pub fun metric_context_precision() {
  return { kind: "ContextPrecision" };
}

pub fun metric_context_recall() {
  return { kind: "ContextRecall" };
}

pub fun metric_context_relevancy() {
  return { kind: "ContextRelevancy" };
}

pub fun metric_answer_correctness() {
  return { kind: "AnswerCorrectness" };
}

pub fun metric_answer_similarity() {
  return { kind: "AnswerSimilarity" };
}

pub fun evaluator_builder(llm) {
  return {
    llm: llm,
    embedder: nil,
    metrics: [
      metric_faithfulness(),
      metric_answer_relevancy(),
      metric_context_precision()
    ]
  };
}

pub fun with_evaluator_embedder(builder, embedder) {
  builder.embedder = embedder;
  return builder;
}

pub fun with_metrics(builder, metrics) {
  builder.metrics = metrics;
  return builder;
}

pub fun add_metric(builder, metric) {
  push(builder.metrics, metric);
  return builder;
}

pub fun build_evaluator(builder) {
  return {
    ok: true,
    value: {
      kind: "RAGEvaluator",
      llm: builder.llm,
      embedder: builder.embedder,
      metrics: builder.metrics
    }
  };
}

pub fun eval_data_point(question, answer, contexts, ground_truth) {
  return {
    question: question,
    answer: answer,
    contexts: contexts,
    ground_truth: ground_truth
  };
}

pub fun evaluate(evaluator, data_point) {
  let results = {};

  for (metric in evaluator.metrics) {
    let score = compute_metric(evaluator, metric, data_point);
    results[metric.kind] = score;
  }

  return {
    scores: results,
    data_point: data_point
  };
}

pub fun evaluate_batch(evaluator, data_points) {
  let results = [];
  let aggregate = {};

  for (metric in evaluator.metrics) {
    aggregate[metric.kind] = { sum: 0.0, count: 0 };
  }

  for (dp in data_points) {
    let result = evaluate(evaluator, dp);
    push(results, result);

    for (metric_name, score in result.scores) {
      if (score != nil) {
        aggregate[metric_name].sum = aggregate[metric_name].sum + score;
        aggregate[metric_name].count = aggregate[metric_name].count + 1;
      }
    }
  }

  let averages = {};
  for (metric_name, agg in aggregate) {
    if (agg.count > 0) {
      averages[metric_name] = agg.sum / agg.count;
    }
  }

  return {
    individual_results: results,
    averages: averages,
    total_evaluated: len(data_points)
  };
}

fun compute_metric(evaluator, metric, data_point) {
  if (metric.kind == "Faithfulness") {
    return compute_faithfulness(evaluator.llm, data_point);
  }
  if (metric.kind == "AnswerRelevancy") {
    return compute_answer_relevancy(evaluator.llm, evaluator.embedder, data_point);
  }
  if (metric.kind == "ContextPrecision") {
    return compute_context_precision(evaluator.llm, data_point);
  }
  if (metric.kind == "ContextRecall") {
    return compute_context_recall(evaluator.llm, data_point);
  }
  if (metric.kind == "ContextRelevancy") {
    return compute_context_relevancy(evaluator.llm, data_point);
  }
  if (metric.kind == "AnswerCorrectness") {
    return compute_answer_correctness(evaluator.llm, data_point);
  }
  if (metric.kind == "AnswerSimilarity") {
    return compute_answer_similarity(evaluator.embedder, data_point);
  }
  return 0.0;
}

fun compute_faithfulness(llm, data_point) {
  let claims_prompt = "Extract all factual claims from this answer as a list:\n\nAnswer: " + data_point.answer + "\n\nClaims (one per line):";
  let claims_response = llm.generate(claims_prompt);
  let claims = split(claims_response, "\n");
  claims = filter(claims, fun(c) { len(trim(c)) > 0 });

  if (len(claims) == 0) {
    return 1.0;
  }

  let context_text = join(data_point.contexts, "\n\n");
  let supported = 0;

  for (claim in claims) {
    let verify_prompt = "Is this claim supported by the context?\n\nContext:\n" + context_text + "\n\nClaim: " + claim + "\n\nRespond with only 'yes' or 'no':";
    let response = lowercase(trim(llm.generate(verify_prompt)));
    if (starts_with(response, "yes")) {
      supported = supported + 1;
    }
  }

  return supported / len(claims);
}

fun compute_answer_relevancy(llm, embedder, data_point) {
  let gen_prompt = "Generate 3 questions that this answer would be a good response to:\n\nAnswer: " + data_point.answer + "\n\nQuestions:";
  let gen_response = llm.generate(gen_prompt);
  let gen_questions = split(gen_response, "\n");
  gen_questions = filter(gen_questions, fun(q) { len(trim(q)) > 5 });

  if (len(gen_questions) == 0 || embedder == nil) {
    return 0.5;
  }

  let original_embedding = embedder.embed(data_point.question);
  let similarities = [];

  for (gen_q in gen_questions) {
    let gen_embedding = embedder.embed(gen_q);
    let sim = embed.cosine_similarity(original_embedding, gen_embedding);
    push(similarities, sim);
  }

  let sum = 0.0;
  for (s in similarities) {
    sum = sum + s;
  }
  return sum / len(similarities);
}

fun compute_context_precision(llm, data_point) {
  if (len(data_point.contexts) == 0) {
    return 0.0;
  }

  let relevant = 0;
  for (context in data_point.contexts) {
    let verify_prompt = "Is this context useful for answering the question?\n\nQuestion: " + data_point.question + "\n\nContext: " + context + "\n\nRespond with only 'yes' or 'no':";
    let response = lowercase(trim(llm.generate(verify_prompt)));
    if (starts_with(response, "yes")) {
      relevant = relevant + 1;
    }
  }

  return relevant / len(data_point.contexts);
}

fun compute_context_recall(llm, data_point) {
  if (data_point.ground_truth == nil) {
    return nil;
  }

  let facts_prompt = "Extract key facts from this ground truth answer:\n\n" + data_point.ground_truth + "\n\nFacts (one per line):";
  let facts_response = llm.generate(facts_prompt);
  let facts = split(facts_response, "\n");
  facts = filter(facts, fun(f) { len(trim(f)) > 0 });

  if (len(facts) == 0) {
    return 1.0;
  }

  let context_text = join(data_point.contexts, "\n\n");
  let found = 0;

  for (fact in facts) {
    let verify_prompt = "Can this fact be found in or inferred from the context?\n\nContext:\n" + context_text + "\n\nFact: " + fact + "\n\nRespond with only 'yes' or 'no':";
    let response = lowercase(trim(llm.generate(verify_prompt)));
    if (starts_with(response, "yes")) {
      found = found + 1;
    }
  }

  return found / len(facts);
}

fun compute_context_relevancy(llm, data_point) {
  let context_text = join(data_point.contexts, "\n\n");

  let prompt = "Rate the relevancy of this context to the question on a scale of 0-10.\n\nQuestion: " + data_point.question + "\n\nContext:\n" + context_text + "\n\nScore (0-10):";
  let response = llm.generate(prompt);
  let match = regex_match(response, "\\d+(\\.\\d+)?");
  let score = parse_float(match || "5");

  return score / 10.0;
}

fun compute_answer_correctness(llm, data_point) {
  if (data_point.ground_truth == nil) {
    return nil;
  }

  let prompt = "Compare the predicted answer to the ground truth.\n\nQuestion: " + data_point.question + "\n\nPredicted Answer: " + data_point.answer + "\n\nGround Truth: " + data_point.ground_truth + "\n\nRate the correctness of the predicted answer on a scale of 0-10:\nScore (0-10):";
  let response = llm.generate(prompt);
  let match = regex_match(response, "\\d+(\\.\\d+)?");
  let score = parse_float(match || "5");

  return score / 10.0;
}

fun compute_answer_similarity(embedder, data_point) {
  if (data_point.ground_truth == nil || embedder == nil) {
    return nil;
  }

  let answer_embedding = embedder.embed(data_point.answer);
  let truth_embedding = embedder.embed(data_point.ground_truth);

  return embed.cosine_similarity(answer_embedding, truth_embedding);
}
