// Pipeline metrics

module std.ingest.metrics;

// Pipeline stages
pub fun stage_source() { return { kind: "Source" }; }
pub fun stage_parse() { return { kind: "Parse" }; }
pub fun stage_transform() { return { kind: "Transform" }; }
pub fun stage_chunk() { return { kind: "Chunk" }; }
pub fun stage_embed() { return { kind: "Embed" }; }
pub fun stage_store() { return { kind: "Store" }; }

// Measurements
pub fun measure_documents_processed(source, count, duration_ms) {
  return {
    kind: "DocumentsProcessed",
    source: source,
    count: count,
    duration_ms: duration_ms
  };
}

pub fun measure_chunks_created(document_id, count, avg_size) {
  return {
    kind: "ChunksCreated",
    document_id: document_id,
    count: count,
    avg_size: avg_size
  };
}

pub fun measure_embeddings_generated(count, tokens, duration_ms, cost_cents) {
  return {
    kind: "EmbeddingsGenerated",
    count: count,
    tokens: tokens,
    duration_ms: duration_ms,
    cost_cents: cost_cents
  };
}

pub fun measure_vectors_stored(count, duration_ms) {
  return {
    kind: "VectorsStored",
    count: count,
    duration_ms: duration_ms
  };
}

pub fun measure_error(stage, error_type, message) {
  return {
    kind: "Error",
    stage: stage,
    error_type: error_type,
    message: message
  };
}

pub fun measure_throughput(docs_per_second, chunks_per_second, bytes_per_second) {
  return {
    kind: "Throughput",
    docs_per_second: docs_per_second,
    chunks_per_second: chunks_per_second,
    bytes_per_second: bytes_per_second
  };
}

// Metrics collector
pub fun metrics_collector(pipeline_name) {
  return {
    pipeline_name: pipeline_name,
    measurements: []
  };
}

pub fun record(collector, measurement) {
  push(collector.measurements, measurement);
  return collector;
}

// Metrics summary
pub fun metrics_summary(total_documents, total_chunks, total_vectors, total_tokens, total_errors, total_duration_ms, avg_doc_processing_ms, avg_chunk_size, throughput_docs_per_sec, total_cost_cents) {
  return {
    total_documents: total_documents,
    total_chunks: total_chunks,
    total_vectors: total_vectors,
    total_tokens: total_tokens,
    total_errors: total_errors,
    total_duration_ms: total_duration_ms,
    avg_doc_processing_ms: avg_doc_processing_ms,
    avg_chunk_size: avg_chunk_size,
    throughput_docs_per_sec: throughput_docs_per_sec,
    total_cost_cents: total_cost_cents
  };
}
