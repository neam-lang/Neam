// Log parser configuration

module std.ingest.parser.log;

// Log formats
pub fun log_format_auto() {
  return { kind: "Auto" };
}

pub fun log_format_common() {
  return { kind: "CommonLog" };
}

pub fun log_format_combined() {
  return { kind: "CombinedLog" };
}

pub fun log_format_json_lines() {
  return { kind: "JsonLines" };
}

pub fun log_format_syslog() {
  return { kind: "Syslog" };
}

pub fun log_format_custom(pattern) {
  return { kind: "Custom", pattern: pattern };
}

pub fun log_format_key_value(separator, delimiter) {
  return { kind: "KeyValue", separator: separator, delimiter: delimiter };
}

// Log pattern
pub fun log_pattern(name, pattern, fields) {
  return { name: name, pattern: pattern, fields: fields };
}

// Log parser
pub fun log_parser() {
  return {
    kind: "Log",
    format: log_format_auto(),
    timestamp_field: nil,
    level_field: nil,
    message_field: nil,
    custom_patterns: []
  };
}

pub fun with_format(parser, format) {
  parser.format = format;
  return parser;
}

pub fun with_timestamp_field(parser, field) {
  parser.timestamp_field = field;
  return parser;
}

pub fun with_level_field(parser, field) {
  parser.level_field = field;
  return parser;
}

pub fun with_message_field(parser, field) {
  parser.message_field = field;
  return parser;
}

pub fun with_pattern(parser, pattern) {
  push(parser.custom_patterns, pattern);
  return parser;
}

// Log levels
pub fun log_level_trace() {
  return { kind: "Trace" };
}

pub fun log_level_debug() {
  return { kind: "Debug" };
}

pub fun log_level_info() {
  return { kind: "Info" };
}

pub fun log_level_warn() {
  return { kind: "Warn" };
}

pub fun log_level_error() {
  return { kind: "Error" };
}

pub fun log_level_fatal() {
  return { kind: "Fatal" };
}
