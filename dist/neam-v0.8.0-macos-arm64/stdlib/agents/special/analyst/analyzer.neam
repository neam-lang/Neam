// Analyst analyzer

module std.agents.special.analyst.analyzer;

// === Analyzer ===

pub fun create(llm) {
  return {
    llm: llm
  };
}

// === Statistical Analysis ===

pub fun compute_statistics(analyzer, dataset) {
  let stats = {};

  for (col in dataset.schema.columns) {
    let col_type = dataset.schema.types[col];

    if (col_type == "numeric") {
      let values = map(dataset.data, fun(row) { row[col]; });
      stats[col] = {
        type: "numeric",
        count: len(values),
        mean: compute_mean(values),
        median: compute_median(values),
        std_dev: compute_std_dev(values),
        min: compute_min(values),
        max: compute_max(values),
        quartiles: compute_quartiles(values)
      };
    } else if (col_type == "string") {
      let values = map(dataset.data, fun(row) { row[col]; });
      stats[col] = {
        type: "categorical",
        count: len(values),
        unique_count: len(unique(values)),
        top_values: compute_value_counts(values, 10)
      };
    } else if (col_type == "datetime") {
      let values = map(dataset.data, fun(row) { row[col]; });
      stats[col] = {
        type: "datetime",
        count: len(values),
        min: compute_min(values),
        max: compute_max(values),
        range_days: date_diff_days(compute_min(values), compute_max(values))
      };
    }
  }

  return {
    ok: true,
    value: {
      kind: "StatisticsResult",
      columns: stats,
      row_count: dataset.row_count,
      computed_at: now()
    }
  };
}

// === Pattern Detection ===

pub fun find_patterns(analyzer, dataset, columns) {
  let patterns = [];

  let numeric_cols = filter(columns, fun(c) { dataset.schema.types[c] == "numeric"; });
  if (len(numeric_cols) >= 2) {
    let correlations = compute_correlations(dataset, numeric_cols);
    for (corr in correlations) {
      if (abs(corr.value) > 0.7) {
        push(patterns, {
          kind: "Correlation",
          columns: [corr.col_a, corr.col_b],
          value: corr.value,
          strength: abs(corr.value) > 0.9 ? "strong" : "moderate"
        });
      }
    }
  }

  let datetime_cols = filter(columns, fun(c) { dataset.schema.types[c] == "datetime"; });
  if (len(datetime_cols) > 0 && len(numeric_cols) > 0) {
    for (dt_col in datetime_cols) {
      for (num_col in numeric_cols) {
        let trend = detect_trend(dataset, dt_col, num_col);
        if (trend.significant) {
          push(patterns, {
            kind: "Trend",
            time_column: dt_col,
            value_column: num_col,
            direction: trend.direction,
            slope: trend.slope
          });
        }
      }
    }
  }

  let categorical_cols = filter(columns, fun(c) { dataset.schema.types[c] == "string"; });
  for (cat_col in categorical_cols) {
    let distribution = compute_value_counts(map(dataset.data, fun(r) { r[cat_col]; }), 20);
    if (is_skewed_distribution(distribution)) {
      push(patterns, {
        kind: "SkewedDistribution",
        column: cat_col,
        dominant_value: distribution[0].value,
        dominant_percent: distribution[0].percent
      });
    }
  }

  return { ok: true, value: patterns };
}

// === Anomaly Detection ===

pub fun detect_anomalies(analyzer, dataset, column) {
  let col_type = dataset.schema.types[column];
  let anomalies = [];

  if (col_type == "numeric") {
    let values = map(dataset.data, fun(row) { row[column]; });
    let mean = compute_mean(values);
    let std_dev = compute_std_dev(values);

    for (i in range(0, len(dataset.data))) {
      let z_score = std_dev == 0 ? 0 : (values[i] - mean) / std_dev;
      if (abs(z_score) > 3) {
        push(anomalies, {
          row_index: i,
          column: column,
          value: values[i],
          z_score: z_score,
          severity: abs(z_score) > 4 ? "high" : "medium"
        });
      }
    }

    let q1 = compute_percentile(values, 25);
    let q3 = compute_percentile(values, 75);
    let iqr = q3 - q1;
    let lower_bound = q1 - 1.5 * iqr;
    let upper_bound = q3 + 1.5 * iqr;

    for (i in range(0, len(dataset.data))) {
      if (values[i] < lower_bound || values[i] > upper_bound) {
        let already_flagged = any(anomalies, fun(a) { a.row_index == i; });
        if (!already_flagged) {
          push(anomalies, {
            row_index: i,
            column: column,
            value: values[i],
            method: "IQR",
            severity: "medium"
          });
        }
      }
    }
  }

  return { ok: true, value: anomalies };
}

// === Analysis Execution ===

pub fun analyze(analyzer, dataset, plan) {
  let results = {
    statistics: nil,
    patterns: [],
    anomalies: [],
    custom: []
  };

  if (plan.include_statistics) {
    results.statistics = compute_statistics(analyzer, dataset).value;
  }

  if (plan.include_patterns && len(plan.pattern_columns) > 0) {
    results.patterns = find_patterns(analyzer, dataset, plan.pattern_columns).value;
  }

  if (plan.include_anomalies && len(plan.anomaly_columns) > 0) {
    for (col in plan.anomaly_columns) {
      let col_anomalies = detect_anomalies(analyzer, dataset, col).value;
      results.anomalies = concat(results.anomalies, col_anomalies);
    }
  }

  return results;
}

// === Prediction ===

pub fun predict(analyzer, dataset, target_column, features) {
  let values = map(dataset.data, fun(row) { row[target_column]; });
  let mean = compute_mean(values);
  return {
    ok: true,
    value: {
      kind: "PredictionResult",
      target: target_column,
      prediction: mean,
      method: "mean"
    }
  };
}

// === Comparison ===

pub fun compare_datasets(analyzer, dataset_a, dataset_b, comparison_type) {
  if (comparison_type == "schema") {
    return compare_schemas(dataset_a.schema, dataset_b.schema);
  }

  if (comparison_type == "statistics") {
    let stats_a = compute_statistics(analyzer, dataset_a).value;
    let stats_b = compute_statistics(analyzer, dataset_b).value;
    return compare_statistics(stats_a, stats_b);
  }

  if (comparison_type == "distribution") {
    return compare_distributions(dataset_a, dataset_b);
  }

  return { ok: false, error: { kind: "UnknownComparisonType", type: comparison_type } };
}

// === Helpers ===

fun compute_mean(values) {
  if (len(values) == 0) { return 0; }
  return sum(values) / len(values);
}

fun compute_median(values) {
  if (len(values) == 0) { return 0; }
  let sorted = sort(values);
  let mid = len(sorted) / 2;
  if (len(sorted) % 2 == 0) {
    return (sorted[mid - 1] + sorted[mid]) / 2;
  }
  return sorted[mid];
}

fun compute_std_dev(values) {
  if (len(values) == 0) { return 0; }
  let mean = compute_mean(values);
  let variance = sum(map(values, fun(v) { (v - mean) * (v - mean); })) / len(values);
  return sqrt(variance);
}

fun compute_min(values) {
  if (len(values) == 0) { return nil; }
  return min(values);
}

fun compute_max(values) {
  if (len(values) == 0) { return nil; }
  return max(values);
}

fun compute_quartiles(values) {
  return {
    q1: compute_percentile(values, 25),
    q2: compute_percentile(values, 50),
    q3: compute_percentile(values, 75)
  };
}

fun compute_percentile(values, percentile) {
  if (len(values) == 0) { return 0; }
  let sorted = sort(values);
  let idx = int((percentile / 100) * (len(sorted) - 1));
  return sorted[idx];
}

fun compute_value_counts(values, limit) {
  let counts = {};
  for (v in values) {
    if (counts[v] == nil) {
      counts[v] = 0;
    }
    counts[v] = counts[v] + 1;
  }

  let total = len(values);
  let pairs = [];
  for (key in keys(counts)) {
    push(pairs, { value: key, count: counts[key], percent: counts[key] / total });
  }

  pairs = sort_by(pairs, fun(p) { return -p.count; });
  return take(pairs, limit);
}

fun unique(values) {
  let seen = {};
  let out = [];
  for (v in values) {
    if (seen[v] == nil) {
      seen[v] = true;
      push(out, v);
    }
  }
  return out;
}

fun date_diff_days(start, end) {
  if (start == nil || end == nil) { return 0; }
  if (typeof(start) == "number" && typeof(end) == "number") {
    return (end - start) / 86400000;
  }
  return 0;
}

fun compute_correlations(dataset, columns) {
  let correlations = [];
  for (i in range(0, len(columns))) {
    for (j in range(i + 1, len(columns))) {
      let col_a = columns[i];
      let col_b = columns[j];
      let values_a = map(dataset.data, fun(row) { row[col_a]; });
      let values_b = map(dataset.data, fun(row) { row[col_b]; });
      let corr = pearson(values_a, values_b);
      push(correlations, { col_a: col_a, col_b: col_b, value: corr });
    }
  }
  return correlations;
}

fun pearson(a, b) {
  if (len(a) == 0 || len(b) == 0) { return 0; }
  let mean_a = compute_mean(a);
  let mean_b = compute_mean(b);
  let numerator = 0;
  let denom_a = 0;
  let denom_b = 0;
  for (i in range(0, len(a))) {
    let da = a[i] - mean_a;
    let db = b[i] - mean_b;
    numerator = numerator + (da * db);
    denom_a = denom_a + (da * da);
    denom_b = denom_b + (db * db);
  }
  let denom = sqrt(denom_a * denom_b);
  if (denom == 0) { return 0; }
  return numerator / denom;
}

fun detect_trend(dataset, dt_col, num_col) {
  let values = map(dataset.data, fun(row) { row[num_col]; });
  let slope = linear_regression_slope(values);
  return {
    significant: abs(slope) > 0.01,
    direction: slope > 0 ? "up" : "down",
    slope: slope
  };
}

fun linear_regression_slope(values) {
  if (len(values) == 0) { return 0; }
  let n = len(values);
  let sum_x = 0;
  let sum_y = 0;
  let sum_xy = 0;
  let sum_x2 = 0;
  for (i in range(0, n)) {
    let x = i + 1;
    let y = values[i];
    sum_x = sum_x + x;
    sum_y = sum_y + y;
    sum_xy = sum_xy + (x * y);
    sum_x2 = sum_x2 + (x * x);
  }
  let numerator = (n * sum_xy) - (sum_x * sum_y);
  let denominator = (n * sum_x2) - (sum_x * sum_x);
  if (denominator == 0) { return 0; }
  return numerator / denominator;
}

fun is_skewed_distribution(distribution) {
  if (len(distribution) == 0) { return false; }
  return distribution[0].percent > 0.5;
}

fun compare_schemas(schema_a, schema_b) {
  return {
    ok: true,
    value: {
      kind: "SchemaComparison",
      columns_a: schema_a.columns,
      columns_b: schema_b.columns,
      shared: intersect(schema_a.columns, schema_b.columns),
      only_a: difference(schema_a.columns, schema_b.columns),
      only_b: difference(schema_b.columns, schema_a.columns)
    }
  };
}

fun compare_statistics(stats_a, stats_b) {
  return {
    ok: true,
    value: {
      kind: "StatisticsComparison",
      stats_a: stats_a,
      stats_b: stats_b
    }
  };
}

fun compare_distributions(dataset_a, dataset_b) {
  return {
    ok: true,
    value: {
      kind: "DistributionComparison",
      row_count_a: dataset_a.row_count,
      row_count_b: dataset_b.row_count
    }
  };
}

fun intersect(a, b) {
  let out = [];
  let set_b = {};
  for (item in b) { set_b[item] = true; }
  for (item in a) { if (set_b[item] != nil) { push(out, item); } }
  return out;
}

fun difference(a, b) {
  let out = [];
  let set_b = {};
  for (item in b) { set_b[item] = true; }
  for (item in a) { if (set_b[item] == nil) { push(out, item); } }
  return out;
}
