// Audio parser configuration

module std.ingest.parser.audio;

// Transcription config
pub fun transcribe_config(enabled, provider, language, speaker_diarization) {
  return {
    enabled: enabled,
    provider: provider,
    language: language,
    speaker_diarization: speaker_diarization
  };
}

pub fun transcribe_disabled() {
  return transcribe_config(false, nil, nil, false);
}

// Transcription providers
pub fun transcribe_whisper(model) { return { kind: "Whisper", model: model }; }
pub fun transcribe_deepgram() { return { kind: "Deepgram" }; }
pub fun transcribe_assembly() { return { kind: "AssemblyAI" }; }
pub fun transcribe_google() { return { kind: "GoogleSpeech" }; }
pub fun transcribe_azure() { return { kind: "AzureSpeech" }; }

// Audio parser
pub fun audio_parser() {
  return {
    kind: "Audio",
    transcribe: transcribe_disabled(),
    extract_metadata: true
  };
}

pub fun with_transcription(parser, config) {
  parser.transcribe = config;
  return parser;
}

pub fun with_metadata_extraction(parser, extract) {
  parser.extract_metadata = extract;
  return parser;
}
