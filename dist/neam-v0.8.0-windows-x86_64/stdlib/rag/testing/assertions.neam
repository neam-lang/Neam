// RAG test assertions

module std.rag.testing.assertions;

pub fun assert_retrieval_count(result, expected) {
  if (len(result.documents) != expected) {
    panic("Expected " + str(expected) + " documents, got " + str(len(result.documents)));
  }
}

pub fun assert_score_above(result, min_score) {
  for (doc in result.documents) {
    if (doc.score < min_score) {
      panic("Document score " + str(doc.score) + " below minimum " + str(min_score));
    }
  }
}

pub fun assert_faithfulness_above(eval_result, min_score) {
  let score = eval_result.scores["Faithfulness"];
  if (score < min_score) {
    panic("Faithfulness score " + str(score) + " below minimum " + str(min_score));
  }
}

pub fun assert_answer_relevancy_above(eval_result, min_score) {
  let score = eval_result.scores["AnswerRelevancy"];
  if (score < min_score) {
    panic("Answer relevancy score " + str(score) + " below minimum " + str(min_score));
  }
}

pub fun assert_context_precision_above(eval_result, min_score) {
  let score = eval_result.scores["ContextPrecision"];
  if (score < min_score) {
    panic("Context precision score " + str(score) + " below minimum " + str(min_score));
  }
}

pub fun assert_cache_hit(result) {
  if (!result.from_cache) {
    panic("Expected cache hit");
  }
}

pub fun assert_cache_miss(result) {
  if (result.from_cache) {
    panic("Expected cache miss");
  }
}

pub fun assert_sources_present(result) {
  if (len(result.sources) == 0) {
    panic("Expected sources to be present");
  }
}

pub fun assert_grounded(self_rag_result) {
  if (!self_rag_result.is_grounded) {
    panic("Expected response to be grounded");
  }
}
