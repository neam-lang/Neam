pub fun sample_research_query() {
  return "Summarize the latest trends in renewable energy.";
}

pub fun sample_dataset() {
  return {
    data: [
      { month: "2024-01-01", sales: 100, region: "west" },
      { month: "2024-02-01", sales: 120, region: "west" },
      { month: "2024-03-01", sales: 90, region: "east" }
    ],
    schema: {
      columns: ["month", "sales", "region"],
      types: { month: "datetime", sales: "numeric", region: "string" }
    }
  };
}

pub fun sample_browser_workflow() {
  return {
    name: "Sample Workflow",
    steps: [
      { action: "goto", url: "https://example.com" },
      { action: "extract", selector: "h1", type: "text", store_as: "headline" }
    ],
    variables: {}
  };
}
