// Browser configuration

module std.agents.special.browser.config;

// === Browser Types ===

pub fun browser_type_chromium() {
  return { kind: "Chromium" };
}

pub fun browser_type_firefox() {
  return { kind: "Firefox" };
}

pub fun browser_type_webkit() {
  return { kind: "WebKit" };
}

// === Wait Conditions ===

pub fun wait_navigation() {
  return { kind: "Navigation" };
}

pub fun wait_selector(selector) {
  return { kind: "Selector", selector: selector };
}

pub fun wait_function(fn) {
  return { kind: "Function", fn: fn };
}

pub fun wait_timeout(ms) {
  return { kind: "Timeout", ms: ms };
}

// === Configuration ===

pub fun browser_config(llm, browser_type, headless, viewport, user_agent,
    timeout_ms, screenshot_on_action, use_accessibility_tree, use_vision,
    max_retries, guards, blocked_domains, allowed_domains, budget) {
  return {
    llm: llm,
    browser_type: browser_type,
    headless: headless,
    viewport: viewport,
    user_agent: user_agent,
    timeout_ms: timeout_ms,
    screenshot_on_action: screenshot_on_action,
    use_accessibility_tree: use_accessibility_tree,
    use_vision: use_vision,
    max_retries: max_retries,
    guards: guards,
    blocked_domains: blocked_domains,
    allowed_domains: allowed_domains,
    budget: budget
  };
}

// === Error Types ===

pub fun browser_error(field, message) {
  return { kind: "BrowserError", field: field, message: message };
}

pub fun navigation_error(url, message) {
  return { kind: "NavigationError", url: url, message: message };
}

pub fun element_not_found_error(selector) {
  return { kind: "ElementNotFound", selector: selector };
}

pub fun domain_blocked_error(url) {
  return { kind: "DomainBlocked", url: url };
}

pub fun execution_error(instruction, detail) {
  return { kind: "ExecutionError", instruction: instruction, detail: detail };
}

pub fun timeout_error(operation, timeout_ms) {
  return { kind: "TimeoutError", operation: operation, timeout_ms: timeout_ms };
}
