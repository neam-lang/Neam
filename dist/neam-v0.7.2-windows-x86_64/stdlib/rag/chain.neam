// RAG chain orchestration

module std.rag.chain;

use std.rag.retriever;
use std.rag.context;
use std.rag.error;

let DEFAULT_PROMPT = "Use the following context to answer the question. If the answer cannot be found in the context, say \"I don't know based on the provided context.\"\n\nContext:\n{context}\n\nQuestion: {question}\n\nAnswer:";

pub fun rag_chain_builder(retriever_instance) {
  return {
    retriever: retriever_instance,
    prompt_template: DEFAULT_PROMPT,
    context_format: context.format_plain(),
    max_context_tokens: 4000,
    include_sources: true,
    llm: nil,
    pre_processors: [],
    post_processors: []
  };
}

pub fun with_prompt_template(builder, template) {
  builder.prompt_template = template;
  return builder;
}

pub fun with_context_format(builder, format) {
  builder.context_format = format;
  return builder;
}

pub fun with_max_context_tokens(builder, max_tokens) {
  builder.max_context_tokens = max_tokens;
  return builder;
}

pub fun with_include_sources(builder, include) {
  builder.include_sources = include;
  return builder;
}

pub fun with_llm(builder, llm) {
  builder.llm = llm;
  return builder;
}

pub fun with_pre_processor(builder, processor) {
  push(builder.pre_processors, processor);
  return builder;
}

pub fun with_post_processor(builder, processor) {
  push(builder.post_processors, processor);
  return builder;
}

pub fun build_rag_chain(builder) {
  if (builder.retriever == nil) {
    return { ok: false, error: error.config_error("retriever", "Retriever is required") };
  }
  if (builder.llm == nil) {
    return { ok: false, error: error.config_error("llm", "LLM is required") };
  }

  return {
    ok: true,
    value: {
      kind: "RAGChain",
      retriever: builder.retriever,
      prompt_template: builder.prompt_template,
      context_format: builder.context_format,
      max_context_tokens: builder.max_context_tokens,
      include_sources: builder.include_sources,
      llm: builder.llm,
      pre_processors: builder.pre_processors,
      post_processors: builder.post_processors
    }
  };
}

pub fun run_chain(chain, question) {
  let processed_question = question;
  for (processor in chain.pre_processors) {
    processed_question = processor(processed_question);
  }

  let docs = retriever.retrieve(chain.retriever, processed_question);

  let ctx_builder = context.context_builder();
  ctx_builder = context.with_documents(ctx_builder, docs);
  ctx_builder = context.with_format(ctx_builder, chain.context_format);
  ctx_builder = context.with_max_tokens(ctx_builder, chain.max_context_tokens);
  ctx_builder = context.with_sources(ctx_builder, chain.include_sources);
  let ctx = context.build_context(ctx_builder);

  let prompt = chain.prompt_template;
  prompt = replace(prompt, "{context}", ctx.text);
  prompt = replace(prompt, "{question}", processed_question);

  let response = chain.llm.generate(prompt);

  for (processor in chain.post_processors) {
    response = processor(response);
  }

  return {
    answer: response,
    sources: ctx.sources,
    context_used: ctx.document_count
  };
}

pub fun run_chain_stream(chain, question, on_token) {
  let processed_question = question;
  for (processor in chain.pre_processors) {
    processed_question = processor(processed_question);
  }

  let docs = retriever.retrieve(chain.retriever, processed_question);

  let ctx_builder = context.context_builder();
  ctx_builder = context.with_documents(ctx_builder, docs);
  ctx_builder = context.with_format(ctx_builder, chain.context_format);
  ctx_builder = context.with_max_tokens(ctx_builder, chain.max_context_tokens);
  let ctx = context.build_context(ctx_builder);

  let prompt = chain.prompt_template;
  prompt = replace(prompt, "{context}", ctx.text);
  prompt = replace(prompt, "{question}", processed_question);

  let full_response = "";
  chain.llm.generate_stream(prompt, fun(token) {
    full_response = full_response + token;
    on_token(token);
  });

  return {
    answer: full_response,
    sources: context.extract_sources(docs),
    context_used: len(docs)
  };
}
