// Agentic retrieval and planning

module std.rag.advanced.agentic;

use std.rag.retriever;

let DEFAULT_PLANNING_PROMPT = "You are a research assistant. Given a question, plan the steps to find the answer using available tools.\n\nAvailable tools:\n{tools}\n\nQuestion: {question}\n\nCreate a step-by-step plan:";

let DEFAULT_EXECUTION_PROMPT = "Execute step {step_num}: {step_description}\n\nPrevious results:\n{context}\n\nProvide the next action in JSON format: {\"tool\": \"tool_name\", \"params\": {...}}";

pub fun tool_retrieve(retriever_instance) {
  return {
    name: "retrieve",
    description: "Search the knowledge base for relevant documents",
    parameters: {
      query: { type: "string", description: "The search query" },
      top_k: { type: "integer", description: "Number of results", default: 4 }
    },
    execute: fun(params) {
      let builder = retriever.retriever_builder(retriever_instance.store);
      builder = retriever.with_top_k(builder, params.top_k || 4);
      builder = retriever.with_embedder(builder, retriever_instance.embedder);
      let r = retriever.build_retriever(builder);
      return retriever.retrieve(r.value, params.query);
    }
  };
}

pub fun tool_web_search(search_fn) {
  return {
    name: "web_search",
    description: "Search the web for additional information",
    parameters: {
      query: { type: "string", description: "The search query" }
    },
    execute: fun(params) {
      return search_fn(params.query);
    }
  };
}

pub fun tool_summarize(llm) {
  return {
    name: "summarize",
    description: "Summarize a collection of documents",
    parameters: {
      documents: { type: "array", description: "Documents to summarize" }
    },
    execute: fun(params) {
      let content = join(map(params.documents, fun(d) { d.content }), "\n\n");
      let prompt = "Summarize the following documents:\n\n" + content + "\n\nSummary:";
      return llm.generate(prompt);
    }
  };
}

pub fun tool_refine_query(llm) {
  return {
    name: "refine_query",
    description: "Refine or expand a query for better retrieval",
    parameters: {
      query: { type: "string", description: "Original query" },
      context: { type: "string", description: "Optional context" }
    },
    execute: fun(params) {
      let prompt = "Refine this query to be more specific and likely to find relevant results:\n\nOriginal query: " + params.query;
      if (params.context != nil) {
        prompt = prompt + "\nContext: " + params.context;
      }
      prompt = prompt + "\n\nRefined query:";
      return llm.generate(prompt);
    }
  };
}

pub fun agentic_rag_config(llm) {
  return {
    llm: llm,
    tools: [],
    max_iterations: 5,
    planning_prompt: DEFAULT_PLANNING_PROMPT,
    execution_prompt: DEFAULT_EXECUTION_PROMPT,
    reflection_enabled: true
  };
}

pub fun with_agentic_tool(config, tool) {
  push(config.tools, tool);
  return config;
}

pub fun with_max_iterations(config, max) {
  config.max_iterations = max;
  return config;
}

pub fun with_planning_prompt(config, prompt) {
  config.planning_prompt = prompt;
  return config;
}

pub fun with_reflection_enabled(config, enabled) {
  config.reflection_enabled = enabled;
  return config;
}

pub fun agentic_rag_chain(config) {
  return {
    kind: "AgenticRAGChain",
    config: config
  };
}

pub fun run_agentic_rag(chain, question) {
  let config = chain.config;
  let execution_log = [];
  let accumulated_context = [];

  let tools_desc = format_tools_description(config.tools);
  let planning_prompt = config.planning_prompt;
  planning_prompt = replace(planning_prompt, "{tools}", tools_desc);
  planning_prompt = replace(planning_prompt, "{question}", question);

  let plan = config.llm.generate(planning_prompt);
  let steps = parse_plan(plan);

  push(execution_log, {
    type: "plan",
    content: plan,
    steps: steps
  });

  for (i, step in enumerate(steps)) {
    if (i >= config.max_iterations) {
      break;
    }

    let exec_prompt = config.execution_prompt;
    exec_prompt = replace(exec_prompt, "{step_num}", str(i + 1));
    exec_prompt = replace(exec_prompt, "{step_description}", step);
    exec_prompt = replace(exec_prompt, "{context}", format_context(accumulated_context));

    let action_json = config.llm.generate(exec_prompt);
    let action = parse_action(action_json);

    if (action != nil) {
      let tool = find_tool(config.tools, action.tool);
      if (tool != nil) {
        let result = tool.execute(action.params);
        push(accumulated_context, {
          step: i + 1,
          tool: action.tool,
          result: result
        });

        push(execution_log, {
          type: "execution",
          step: i + 1,
          tool: action.tool,
          params: action.params,
          result: result
        });
      }
    }

    if (config.reflection_enabled && i > 0) {
      let should_continue = reflect_on_progress(config.llm, question, accumulated_context);
      if (!should_continue) {
        push(execution_log, {
          type: "reflection",
          decision: "sufficient_information",
          step: i + 1
        });
        break;
      }
    }
  }

  let final_context = format_final_context(accumulated_context);
  let answer_prompt = "Based on the following research results, answer the question.\n\nQuestion: " + question + "\n\nResearch results:\n" + final_context + "\n\nAnswer:";
  let answer = config.llm.generate(answer_prompt);

  return {
    answer: answer,
    execution_log: execution_log,
    steps_executed: len(execution_log) - 1,
    sources: extract_sources_from_context(accumulated_context)
  };
}

fun format_tools_description(tools) {
  let descriptions = [];
  for (tool in tools) {
    push(descriptions, "- " + tool.name + ": " + tool.description);
  }
  return join(descriptions, "\n");
}

fun parse_plan(plan_text) {
  let steps = [];
  let lines = split(plan_text, "\n");

  for (line in lines) {
    let cleaned = trim(line);
    if (len(cleaned) > 0 && (starts_with(cleaned, "-") || regex_match(cleaned, "^\\d+\\."))) {
      cleaned = regex_replace(cleaned, "^[-\\d.]+\\s*", "");
      push(steps, cleaned);
    }
  }

  return steps;
}

fun parse_action(json_text) {
  let match = regex_match(json_text, "\\{[^}]+\\}");
  if (match != nil) {
    return json_parse(match);
  }
  return nil;
}

fun find_tool(tools, name) {
  for (tool in tools) {
    if (tool.name == name) {
      return tool;
    }
  }
  return nil;
}

fun reflect_on_progress(llm, question, context) {
  let prompt = "Question: " + question + "\n\nInformation gathered so far:\n" + format_context(context) + "\n\nDo we have enough information to answer the question? Respond with only 'yes' or 'no':";
  let response = lowercase(trim(llm.generate(prompt)));
  return starts_with(response, "no");
}

fun format_context(context) {
  let parts = [];
  for (item in context) {
    push(parts, "Step " + str(item.step) + " (" + item.tool + "): " + json_stringify(item.result));
  }
  return join(parts, "\n");
}

fun format_final_context(context) {
  let parts = [];
  for (item in context) {
    if (item.result != nil) {
      if (is_array(item.result)) {
        for (doc in item.result) {
          push(parts, doc.content);
        }
      } else if (is_string(item.result)) {
        push(parts, item.result);
      }
    }
  }
  return join(parts, "\n\n---\n\n");
}

fun extract_sources_from_context(context) {
  let sources = [];
  for (item in context) {
    if (item.result != nil && is_array(item.result)) {
      for (doc in item.result) {
        if (doc.metadata != nil && doc.metadata.source != nil) {
          push(sources, {
            id: doc.id,
            source: doc.metadata.source
          });
        }
      }
    }
  }
  return sources;
}
