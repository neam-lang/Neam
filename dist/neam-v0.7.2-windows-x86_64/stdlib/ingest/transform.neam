// Text transformation utilities

module std.ingest.transform;

// Text cleaning transform
pub fun clean_transform() {
  return {
    kind: "Clean",
    remove_extra_whitespace: true,
    remove_special_chars: false,
    normalize_unicode: true,
    remove_urls: false,
    remove_emails: false,
    lowercase: false,
    custom_replacements: []
  };
}

pub fun with_extra_whitespace(transform, remove) {
  transform.remove_extra_whitespace = remove;
  return transform;
}

pub fun with_special_chars(transform, remove) {
  transform.remove_special_chars = remove;
  return transform;
}

pub fun with_unicode(transform, normalize) {
  transform.normalize_unicode = normalize;
  return transform;
}

pub fun with_urls(transform, remove) {
  transform.remove_urls = remove;
  return transform;
}

pub fun with_emails(transform, remove) {
  transform.remove_emails = remove;
  return transform;
}

pub fun with_lowercase(transform, lower) {
  transform.lowercase = lower;
  return transform;
}

pub fun with_replacement(transform, from, to) {
  push(transform.custom_replacements, { from: from, to: to });
  return transform;
}

// Entity provider types
pub fun entity_provider_spacy(model) { return { kind: "Spacy", model: model }; }
pub fun entity_provider_flair(model) { return { kind: "Flair", model: model }; }
pub fun entity_provider_openai(model) { return { kind: "OpenAI", model: model }; }
pub fun entity_provider_regex(patterns) { return { kind: "Regex", patterns: patterns }; }

// Entity extraction transform
pub fun entity_extract_transform(provider) {
  return {
    kind: "EntityExtract",
    provider: provider,
    extract_types: []
  };
}

pub fun with_extract_types(transform, types) {
  transform.extract_types = types;
  return transform;
}

// Keyword extraction methods
pub fun keyword_rake() { return { kind: "Rake" }; }
pub fun keyword_yake() { return { kind: "Yake" }; }
pub fun keyword_tfidf() { return { kind: "TfIdf" }; }
pub fun keyword_llm(model) { return { kind: "LLM", model: model }; }

// Summary provider
pub fun summary_openai(model) { return { kind: "OpenAI", model: model }; }
pub fun summary_anthropic(model) { return { kind: "Anthropic", model: model }; }
pub fun summary_local(model_path) { return { kind: "Local", model_path: model_path }; }

// Enrichment transform
pub fun enrich_transform() {
  return {
    kind: "Enrich",
    detect_language: true,
    extract_keywords: false,
    keyword_method: nil,
    max_keywords: 10,
    generate_summary: false,
    summary_provider: nil,
    summary_max_length: 200
  };
}

pub fun with_language_detection(transform, detect) {
  transform.detect_language = detect;
  return transform;
}

pub fun with_keywords(transform, method, max_keywords) {
  transform.extract_keywords = true;
  transform.keyword_method = method;
  transform.max_keywords = max_keywords;
  return transform;
}

pub fun with_summary(transform, provider, max_length) {
  transform.generate_summary = true;
  transform.summary_provider = provider;
  transform.summary_max_length = max_length;
  return transform;
}

// Content filters
pub fun filter_min_length(len) { return { kind: "MinLength", value: len }; }
pub fun filter_max_length(len) { return { kind: "MaxLength", value: len }; }
pub fun filter_must_contain(keywords) { return { kind: "MustContain", keywords: keywords }; }
pub fun filter_must_not_contain(keywords) { return { kind: "MustNotContain", keywords: keywords }; }
pub fun filter_language(langs) { return { kind: "Language", languages: langs }; }

// Filter transform
pub fun filter_transform() {
  return {
    kind: "Filter",
    filters: []
  };
}

pub fun with_content_filter(transform, filter) {
  push(transform.filters, filter);
  return transform;
}

pub fun with_min_length(transform, len) {
  push(transform.filters, filter_min_length(len));
  return transform;
}

pub fun with_max_length(transform, len) {
  push(transform.filters, filter_max_length(len));
  return transform;
}

pub fun with_must_contain(transform, keywords) {
  push(transform.filters, filter_must_contain(keywords));
  return transform;
}

pub fun with_must_not_contain(transform, keywords) {
  push(transform.filters, filter_must_not_contain(keywords));
  return transform;
}

pub fun with_language_filter(transform, languages) {
  push(transform.filters, filter_language(languages));
  return transform;
}
