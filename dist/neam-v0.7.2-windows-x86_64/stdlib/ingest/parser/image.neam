// Image parser configuration

module std.ingest.parser.image;

// Captioning config
pub fun captioning_config(enabled, provider, detail_level) {
  return {
    enabled: enabled,
    provider: provider,
    detail_level: detail_level
  };
}

pub fun captioning_disabled() {
  return captioning_config(false, nil, nil);
}

// Captioning providers
pub fun caption_openai(model) { return { kind: "OpenAI", model: model }; }
pub fun caption_anthropic(model) { return { kind: "Anthropic", model: model }; }
pub fun caption_google() { return { kind: "GoogleVision" }; }
pub fun caption_azure() { return { kind: "AzureVision" }; }
pub fun caption_local(model_path) { return { kind: "Local", model_path: model_path }; }

// Detail levels
pub fun detail_brief() { return { kind: "Brief" }; }
pub fun detail_standard() { return { kind: "Standard" }; }
pub fun detail_detailed() { return { kind: "Detailed" }; }

// Image resize
pub fun image_resize(max_width, max_height, preserve_aspect) {
  return {
    max_width: max_width,
    max_height: max_height,
    preserve_aspect: preserve_aspect
  };
}

// Image parser
pub fun image_parser() {
  return {
    kind: "Image",
    ocr: std.ingest.parser.ocr.ocr_disabled(),
    captioning: captioning_disabled(),
    extract_exif: true,
    resize: nil
  };
}

pub fun with_captioning(parser, config) {
  parser.captioning = config;
  return parser;
}

pub fun with_exif(parser, extract) {
  parser.extract_exif = extract;
  return parser;
}

pub fun with_resize(parser, resize) {
  parser.resize = resize;
  return parser;
}
