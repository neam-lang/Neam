// Analyst agent implementation

module std.agents.special.analyst.agent;

use std.agents.special.base;
use std.agents.special.analyst.data_loader;
use std.agents.special.analyst.analyzer;
use std.agents.special.analyst.visualizer;
use std.agents.special.analyst.config;

// === Type Constructors ===

pub fun analyst_agent(config) {
  return {
    kind: "AnalystAgent",
    config: config,
    data_loader: data_loader.create(config),
    analyzer: analyzer.create(config.llm),
    visualizer: visualizer.create(config),
    datasets: {},
    analysis_history: []
  };
}

// === Builder Pattern ===

pub fun analyst_builder(llm) {
  return {
    llm: llm,
    analysis_depth: config.analysis_depth_standard(),
    enable_statistics: true,
    enable_patterns: true,
    enable_anomalies: true,
    enable_predictions: false,
    visualization_formats: ["chart", "table"],
    max_rows_in_memory: 100000,
    sampling_strategy: config.sampling_strategy_auto(),
    guards: [],
    budget: nil
  };
}

pub fun with_analysis_depth(builder, depth) {
  builder.analysis_depth = depth;
  return builder;
}

pub fun with_statistics(builder, enabled) {
  builder.enable_statistics = enabled;
  return builder;
}

pub fun with_pattern_detection(builder, enabled) {
  builder.enable_patterns = enabled;
  return builder;
}

pub fun with_anomaly_detection(builder, enabled) {
  builder.enable_anomalies = enabled;
  return builder;
}

pub fun with_predictions(builder, enabled) {
  builder.enable_predictions = enabled;
  return builder;
}

pub fun with_visualization_formats(builder, formats) {
  builder.visualization_formats = formats;
  return builder;
}

pub fun with_max_rows(builder, max) {
  builder.max_rows_in_memory = max;
  return builder;
}

pub fun with_sampling(builder, strategy) {
  builder.sampling_strategy = strategy;
  return builder;
}

pub fun build_analyst_agent(builder) {
  if (builder.llm == nil) {
    return { ok: false, error: config.analyst_error("llm", "LLM is required") };
  }

  let agent_config = config.analyst_config(
    builder.llm,
    builder.analysis_depth,
    builder.enable_statistics,
    builder.enable_patterns,
    builder.enable_anomalies,
    builder.enable_predictions,
    builder.visualization_formats,
    builder.max_rows_in_memory,
    builder.sampling_strategy,
    builder.guards,
    builder.budget
  );

  return { ok: true, value: analyst_agent(agent_config) };
}

// === Core Operations ===

pub fun load_data(agent, source, options) {
  let load_result = data_loader.load(agent.data_loader, source, options);
  if (!load_result.ok) {
    return load_result;
  }

  let dataset = load_result.value;
  let dataset_id = base.generate_dataset_id();
  agent.datasets[dataset_id] = dataset;

  return { ok: true, value: { dataset_id: dataset_id, schema: dataset.schema, row_count: dataset.row_count } };
}

pub fun analyze(agent, dataset_id, question) {
  let dataset = agent.datasets[dataset_id];
  if (dataset == nil) {
    return { ok: false, error: config.analyst_error("dataset", "Dataset not found: " + dataset_id) };
  }

  let analysis_plan = plan_analysis(agent, question, dataset);
  let results = analyzer.analyze(agent.analyzer, dataset, analysis_plan);

  let visuals = [];
  if (len(agent.config.visualization_formats) > 0) {
    visuals = visualizer.visualize(agent.visualizer, results, analysis_plan);
  }

  let insights = generate_insights(agent, question, results);

  let analysis_record = {
    question: question,
    dataset_id: dataset_id,
    results: results,
    visuals: visuals,
    insights: insights,
    timestamp: now()
  };
  push(agent.analysis_history, analysis_record);

  return {
    ok: true,
    value: analysis_report(question, results, visuals, insights)
  };
}

pub fun quick_stats(agent, dataset_id) {
  let dataset = agent.datasets[dataset_id];
  if (dataset == nil) {
    return { ok: false, error: config.analyst_error("dataset", "Dataset not found") };
  }

  return analyzer.compute_statistics(agent.analyzer, dataset);
}

pub fun detect_anomalies(agent, dataset_id, column) {
  let dataset = agent.datasets[dataset_id];
  if (dataset == nil) {
    return { ok: false, error: config.analyst_error("dataset", "Dataset not found") };
  }

  return analyzer.detect_anomalies(agent.analyzer, dataset, column);
}

pub fun find_patterns(agent, dataset_id, columns) {
  let dataset = agent.datasets[dataset_id];
  if (dataset == nil) {
    return { ok: false, error: config.analyst_error("dataset", "Dataset not found") };
  }

  return analyzer.find_patterns(agent.analyzer, dataset, columns);
}

pub fun predict(agent, dataset_id, target_column, features) {
  if (!agent.config.enable_predictions) {
    return { ok: false, error: config.analyst_error("predictions", "Predictions not enabled") };
  }

  let dataset = agent.datasets[dataset_id];
  return analyzer.predict(agent.analyzer, dataset, target_column, features);
}

pub fun ask(agent, dataset_id, question) {
  return analyze(agent, dataset_id, question);
}

pub fun compare(agent, dataset_id_a, dataset_id_b, comparison_type) {
  let dataset_a = agent.datasets[dataset_id_a];
  let dataset_b = agent.datasets[dataset_id_b];

  if (dataset_a == nil || dataset_b == nil) {
    return { ok: false, error: config.analyst_error("datasets", "One or more datasets not found") };
  }

  return analyzer.compare_datasets(agent.analyzer, dataset_a, dataset_b, comparison_type);
}

// === Report Generation ===

pub fun analysis_report(question, results, visuals, insights) {
  return {
    kind: "AnalysisReport",
    question: question,
    results: results,
    visualizations: visuals,
    insights: insights,
    generated_at: now()
  };
}

pub fun generate_insights(agent, question, results) {
  let context = format_results_for_llm(results);
  let prompt = "Based on the following data analysis results, provide 3-5 key insights that answer the question: " + question + "\n\nResults:\n" + context + "\n\nKey Insights:";

  let response = agent.config.llm.generate(prompt);
  let lines = split(response, "\n");

  return map(filter(lines, fun(l) { len(trim(l)) > 10; }), fun(l) {
    return {
      text: trim(regex_replace(l, "^[\\d.\\-*]+\\s*", "")),
      confidence: 0.8
    };
  });
}

// === Planning ===

fun plan_analysis(agent, question, dataset) {
  let analysis_depth = agent.config.analysis_depth.kind;

  let include_stats = agent.config.enable_statistics;
  let include_patterns = agent.config.enable_patterns;
  let include_anomalies = agent.config.enable_anomalies;

  if (analysis_depth == "Quick") {
    include_patterns = false;
    include_anomalies = false;
  }
  if (analysis_depth == "Deep") {
    include_patterns = true;
    include_anomalies = true;
  }

  return {
    include_statistics: include_stats,
    include_patterns: include_patterns,
    include_anomalies: include_anomalies,
    pattern_columns: dataset.schema.columns,
    anomaly_columns: filter(dataset.schema.columns, fun(c) { dataset.schema.types[c] == "numeric"; }),
    question: question
  };
}

fun format_results_for_llm(results) {
  let summary = [];
  if (results.statistics != nil) {
    push(summary, "Statistics: " + json_stringify(results.statistics));
  }
  if (len(results.patterns) > 0) {
    push(summary, "Patterns: " + json_stringify(results.patterns));
  }
  if (len(results.anomalies) > 0) {
    push(summary, "Anomalies: " + json_stringify(results.anomalies));
  }
  return join(summary, "\n");
}
